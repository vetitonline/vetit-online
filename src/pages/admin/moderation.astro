---
import '../../../styles.css';
import SiteHeader from '../../components/SiteHeader.astro';
import ModerationPanel from '../../components/seller/ModerationPanel.astro';
import {authenticateApiRequest} from '../../lib/supabase/api-auth';
import {loadModerationStatus,moderationSubject,ModerationError} from '../../lib/moderation/workflow.js';
import type {QueueClient} from '../../lib/moderation/queue.js';
Astro.response.headers.set('Cache-Control','private, no-store');Astro.response.headers.set('Vary','Cookie, Authorization');
const auth=await authenticateApiRequest(Astro.request,Astro.cookies);
if(auth.state==='unauthenticated')return Astro.redirect('/admin/login',302);
let data=null;let target=null;
try{if(auth.state!=='authenticated')throw new ModerationError('Unavailable',503);if(![true,'true'].includes(auth.user.app_metadata?.vetit_reviewer))throw new ModerationError('Forbidden',403);target=moderationSubject(Astro.url.searchParams.get('kind'),Astro.url.searchParams.get('subject'));data=await loadModerationStatus(auth.supabase as unknown as QueueClient,target.kind,target.subject);}catch(error){Astro.response.status=error instanceof ModerationError?error.status:503;}
---
<!doctype html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Moderation decision | Vetit Online</title></head><body><div class="page-shell"><SiteHeader adminMode /><main class="seller-page"><a href="/admin/cases">Review queue / समीक्षा सूची</a>{data&&target?<ModerationPanel reviewer status={data} kind={target.kind} subject={target.subject}/>:<p role="alert">Review unavailable or access denied. / समीक्षा उपलब्ध नहीं है या अनुमति नहीं है।</p>}</main></div></body></html>
