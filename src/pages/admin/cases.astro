---
import '../../../styles.css';
import SiteHeader from '../../components/SiteHeader.astro';
import {authenticateApiRequest} from '../../lib/supabase/api-auth';
import {loadModerationQueue,ModerationError,type ModerationQueue} from '../../lib/moderation/workflow.js';
import type {QueueClient} from '../../lib/moderation/queue.js';
Astro.response.headers.set('Cache-Control','private, no-store');Astro.response.headers.set('Vary','Cookie, Authorization');
const auth=await authenticateApiRequest(Astro.request,Astro.cookies);if(auth.state==='unauthenticated')return Astro.redirect('/admin/login',302);
let data:ModerationQueue|null=null;
try{if(auth.state!=='authenticated')throw new ModerationError('Unavailable',503);if(![true,'true'].includes(auth.user.app_metadata?.vetit_reviewer))throw new ModerationError('Forbidden',403);data=await loadModerationQueue(auth.supabase as unknown as QueueClient,Astro.url.searchParams);}catch(error){Astro.response.status=error instanceof ModerationError?error.status:503;}
const params=Astro.url.searchParams;const last=data?.items.at(-1);const next=new URLSearchParams(params);if(last){next.set('before',last.created_at);next.set('id',last.id);}
const choices={kind:['seller','product','service'],state:['pending','screened','eligible','approved','rejected','corrections','escalated','blocked'],classification:['ordinary','regulated','veterinary','live_animal','prohibited','unconfigured']};
---
<!doctype html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Moderation cases | Vetit Online</title></head><body><div class="page-shell"><SiteHeader adminMode/><main class="seller-page"><section class="seller-panel"><h1>Moderation cases / समीक्षा मामले</h1><a href="/admin/review">Listing overview / लिस्टिंग सूची</a>
{data?<><form method="get" class="seller-business-form">{Object.entries(choices).map(([key,values])=><label>{key}<select name={key}><option value="">All / सभी</option>{values.map(value=><option value={value} selected={params.get(key)===value}>{value}</option>)}</select></label>)}<label>Market / बाज़ार<input name="market" maxlength="2" value={params.get('market')??''}/></label><label>Category ID<input name="category" maxlength="36" value={params.get('category')??''}/></label><button class="button button-secondary" type="submit">Filter / छाँटें</button><a href="/admin/cases">Clear</a></form>
<p role="status">{data.items.length} cases on this page. Classification comes from configured policy; it is not a completed risk assessment.</p>{data.items.map(item=><article class="seller-panel"><h2>{item.title}</h2><p>{item.seller_name} · {item.subject_kind} · {item.market} · {item.classification} · {item.state}</p>{item.automatic_approval?.status==='approved'&&item.state==='eligible'&&<p>Automatically approved · Publication pending / स्वतः अनुमोदित · प्रकाशन लंबित</p>}{item.automatic_approval?.status==='review_required'&&item.state!=='approved'&&<p>Fresh review required / नई समीक्षा आवश्यक</p>}<ul>{item.reasons.map(reason=><li><code>{reason}</code></li>)}</ul><p><time datetime={item.updated_at}>{item.updated_at}</time></p><a href={`/admin/moderation?kind=${item.subject_kind}&subject=${item.subject_id}`}>Open review / समीक्षा खोलें</a></article>)}{!data.items.length&&<p>No cases match these filters. / कोई मामला नहीं मिला।</p>}{data.hasMore&&last&&<a href={`/admin/cases?${next}`}>Next / अगला</a>}</>:<p role="alert">Moderation queue unavailable or access denied. / समीक्षा सूची उपलब्ध नहीं है या अनुमति नहीं है।</p>}
</section></main></div></body></html>
