---
import '../../styles.css';
import ProductCard from '../components/marketplace/ProductCard.astro';
import { getMarketplaceProducts, getProductTaxonomy } from '../lib/marketplace/featured-products';
import { filterMarketplaceProducts } from '../lib/marketplace/catalog';
import { categoriesForAnimal, findAnimal, findCategory } from '../lib/marketplace/product-taxonomy';
import SiteHeader from '../components/SiteHeader.astro';
import PhotoCategoryArt from '../components/marketplace/PhotoCategoryArt.astro';

const result = await getMarketplaceProducts(Astro.request, Astro.cookies);
const taxonomy = await getProductTaxonomy(Astro.request, Astro.cookies);
const params = Astro.url.searchParams;
const query = params.get('q')?.trim() ?? '';
const animal = params.get('animal')?.trim() ?? '';
const category = params.get('category')?.trim() ?? '';
const minPriceRaw = params.get('min') ?? '';
const maxPriceRaw = params.get('max') ?? '';
const minPrice = minPriceRaw !== '' && Number.isFinite(Number(minPriceRaw)) ? Number(minPriceRaw) * 100 : null;
const maxPrice = maxPriceRaw !== '' && Number.isFinite(Number(maxPriceRaw)) ? Number(maxPriceRaw) * 100 : null;
const sort = params.get('sort') ?? 'newest';
const selectedAnimal = findAnimal(taxonomy.animals, animal);
const selectedCategory = findCategory(taxonomy.categories, category);
const filteredProducts = filterMarketplaceProducts(result.products, { query, animal: selectedAnimal, category: selectedCategory, minPrice, maxPrice, sort });
const page = Math.max(1, Number.parseInt(params.get('page') ?? '1', 10) || 1);
const pageSize = 24;
const pageCount = Math.max(1, Math.ceil(filteredProducts.length / pageSize));
const pageProducts = filteredProducts.slice((page - 1) * pageSize, page * pageSize);
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Products | Vetit Online</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&display=swap" rel="stylesheet">
</head>
<body>
  <div class="page-shell">
    <SiteHeader />

    <main>
      <section class="product-showcase" id="all-products">
        <div class="product-heading">
          <div>
            <span class="section-label dark-label"><span></span>Marketplace</span>
            <h1>Everything your pets &amp; livestock need.</h1>
            <p>Search published product listings from Vetit sellers across India.</p>
          </div>
        </div>

        <nav class="catalog-species-selector" aria-label="Browse products by pet or livestock">
          <a class:list={['catalog-species-card', !animal && 'active']} href="/products" aria-current={!animal ? 'page' : undefined}>
            <span class="catalog-all-icon" aria-hidden="true"><svg viewBox="0 0 32 32"><path d="M6 9h20M6 16h20M6 23h20" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/><circle cx="11" cy="9" r="2" fill="currentColor"/><circle cx="21" cy="16" r="2" fill="currentColor"/></svg></span>
            <span>All pets &amp; livestock</span>
          </a>
          {taxonomy.animals.map((item) => <a class:list={['catalog-species-card', animal === item.slug && 'active']} href={`/shop/${item.slug}`} aria-current={animal === item.slug ? 'page' : undefined}>
            <PhotoCategoryArt slug={item.slug} label={item.label} />
            <span>{item.slug === 'fish' ? 'Fish & Aquatics' : item.slug === 'cattle' ? 'Livestock & Cattle' : item.label}</span>
          </a>)}
        </nav>
        <p class="catalog-service-link"><a href="/services">Looking for care? Explore Pet &amp; Vet Services →</a></p>

        <form class="catalog-filters" method="get" action="/products">
          <label class="catalog-search-label">Search products
            <input type="search" name="q" value={query} placeholder="Product, category or seller" maxlength="100">
          </label>
          <label>Pets &amp; livestock
            <select name="animal">
              <option value="">All pets &amp; livestock</option>
              {taxonomy.animals.map((item) => <option value={item.slug} selected={animal === item.slug}>{item.label}</option>)}
            </select>
          </label>
          <label>Category
            <select name="category">
              <option value="">All categories</option>
              {categoriesForAnimal(taxonomy.categories, selectedAnimal ?? { id: '', slug: '', label: '' }).map((item) => <option value={item.slug} selected={category === item.slug}>{item.label}</option>)}
            </select>
          </label>
          <label>Min price (₹)<input name="min" type="number" min="0" step="1" value={minPriceRaw} inputmode="numeric"></label>
          <label>Max price (₹)<input name="max" type="number" min="0" step="1" value={maxPriceRaw} inputmode="numeric"></label>
          <label>Sort by
            <select name="sort">
              <option value="newest" selected={sort === 'newest'}>Newest</option>
              <option value="price-asc" selected={sort === 'price-asc'}>Price: low to high</option>
              <option value="price-desc" selected={sort === 'price-desc'}>Price: high to low</option>
              <option value="name" selected={sort === 'name'}>Name</option>
            </select>
          </label>
          <button class="button button-primary" type="submit">Apply filters</button>
          <a class="catalog-clear" href="/products">Clear</a>
        </form>
        <p class="catalog-data-note">Published product details and available seller photos appear here as listings are added.</p>

        <div class="product-grid">
          {result.state === 'available' && pageProducts.map((product) => <ProductCard product={product} />)}

          {pageProducts.length === 0 && (
            <p class="product-empty-state">
              {result.state === 'error'
                ? 'The marketplace is temporarily unavailable. Please try again later.'
                : (query || animal || category || minPriceRaw || maxPriceRaw)
                  ? 'No products in this category yet.'
                  : 'No published products yet. Check back when sellers add their listings.'}
              {' '}<a href="/services">Explore Pet &amp; Vet Services</a>
            </p>
          )}
        </div>
        {pageCount > 1 && <nav class="catalog-pagination" aria-label="Product pages">
          {page > 1 && <a class="button button-secondary small-button" href={`?${new URLSearchParams({ q: query, animal, category, min: minPriceRaw, max: maxPriceRaw, sort, page: String(page - 1) })}`}>Previous</a>}
          <span>Page {page} of {pageCount}</span>
          {page < pageCount && <a class="button button-secondary small-button" href={`?${new URLSearchParams({ q: query, animal, category, min: minPriceRaw, max: maxPriceRaw, sort, page: String(page + 1) })}`}>Next</a>}
        </nav>}
        <p class="catalog-count">{filteredProducts.length} product{filteredProducts.length === 1 ? '' : 's'} shown{filteredProducts.length === 1000 ? ' (first 1,000 published listings)' : ''}</p>
        <p class="sr-only" data-cart-status role="status" aria-live="polite"></p>
      </section>
    </main>
  </div>
  <script src="../../script.js"></script>
</body>
</html>
