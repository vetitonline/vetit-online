---
import '../../styles.css';
import ProductCard from '../components/marketplace/ProductCard.astro';
import {readPublicCatalog} from '../lib/marketplace/catalog-reader';
import {buildProductsUrl} from '../lib/marketplace/catalog-client.js';
import {categoryNavigation,categoriesForSpecies} from '../lib/marketplace/category-navigation.js';
import SiteHeader from '../components/SiteHeader.astro';
import PhotoCategoryArt from '../components/marketplace/PhotoCategoryArt.astro';

const response = await readPublicCatalog(Astro.request, Astro.cookies);
const result=response.body;
if(response.status!==200)Astro.response.status=response.status;
const taxonomy=result.taxonomy;
const params = Astro.url.searchParams;
const query = result.filters.query;
const animal = params.get('animal')?.trim() ?? '';
const category = params.get('category')?.trim() ?? '';
const minPriceRaw = params.get('min') ?? '';
const maxPriceRaw = params.get('max') ?? '';
const sort = result.filters.sort;
const selectedAnimal = taxonomy.animals.find(item=>item.slug===result.filters.animal);
const categoryOptions = categoriesForSpecies(taxonomy.categories,selectedAnimal?.id);
const tree=categoryNavigation(taxonomy.categories,selectedAnimal?.id,result.filters.category??undefined);
const {page,pageSize,pageCount}=result.pagination;
const pageProducts=result.products;
const browseHref=(categorySlug?:string,requestedPage?:number)=>buildProductsUrl({query,animal:result.filters.animal??animal,category:categorySlug,minPriceRupees:minPriceRaw,maxPriceRupees:maxPriceRaw,sort:sort as 'newest'|'price-asc'|'price-desc'|'name',page:requestedPage,pageSize});
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Products | Vetit Online</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&display=swap" rel="stylesheet">
</head>
<body>
  <div class="page-shell">
    <SiteHeader />

    <main>
      <section class="product-showcase" id="all-products">
        <div class="product-heading">
          <div>
            <span class="section-label dark-label"><span></span>Marketplace</span>
            <h1>Everything your pets &amp; livestock need.</h1>
            <p>Search published product listings from Vetit sellers across India.</p>
          </div>
        </div>

        <nav class="catalog-species-selector" aria-label="Browse products by pet or livestock">
          <a class:list={['catalog-species-card', !animal && 'active']} href="/products" aria-current={!animal ? 'page' : undefined}>
            <span class="catalog-all-icon" aria-hidden="true"><svg viewBox="0 0 32 32"><path d="M6 9h20M6 16h20M6 23h20" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/><circle cx="11" cy="9" r="2" fill="currentColor"/><circle cx="21" cy="16" r="2" fill="currentColor"/></svg></span>
            <span>All pets &amp; livestock</span>
          </a>
          {taxonomy.animals.map((item) => <a class:list={['catalog-species-card', animal === item.slug && 'active']} href={`/shop/${item.slug}`} aria-current={animal === item.slug ? 'page' : undefined}>
            <PhotoCategoryArt slug={item.slug} label={item.label} />
            <span>{item.slug === 'fish' ? 'Fish & Aquatics' : item.slug === 'cattle' ? 'Livestock & Cattle' : item.label}</span>
          </a>)}
        </nav>
        <p class="catalog-service-link"><a href="/services">Looking for care? Explore Pet &amp; Vet Services →</a></p>

        <form class="catalog-filters" method="get" action="/products">
          <label class="catalog-search-label">Search products
            <input type="search" name="q" value={query} placeholder="Product, category or seller" maxlength="100">
          </label>
          <label>Pets &amp; livestock
            <select name="animal">
              <option value="">All pets &amp; livestock</option>
              {taxonomy.animals.map((item) => <option value={item.slug} selected={animal === item.slug}>{item.label}</option>)}
            </select>
          </label>
          <label>Category
            <select name="category">
              <option value="">All categories</option>
              {categoryOptions.map((item) => <option value={item.slug} selected={category === item.slug}>{item.label}</option>)}
            </select>
          </label>
          <label>Min price (₹)<input name="min" type="number" min="0" step="1" value={minPriceRaw} inputmode="numeric"></label>
          <label>Max price (₹)<input name="max" type="number" min="0" step="1" value={maxPriceRaw} inputmode="numeric"></label>
          <label>Sort by
            <select name="sort">
              <option value="newest" selected={sort === 'newest'}>Newest</option>
              <option value="price-asc" selected={sort === 'price-asc'}>Price: low to high</option>
              <option value="price-desc" selected={sort === 'price-desc'}>Price: high to low</option>
              <option value="name" selected={sort === 'name'}>Name</option>
            </select>
          </label>
          <button class="button button-primary" type="submit">Apply filters</button>
          <a class="catalog-clear" href="/products">Clear</a>
        </form>
        <nav class="subcategory-links" aria-label="Product category navigation">
          <a class="catalog-chip" href={browseHref()} aria-current={!category?'page':undefined}>All categories</a>
          {tree.roots.map(item=><a class="catalog-chip" href={browseHref(item.slug)} aria-current={category===item.slug?'page':undefined}>{item.label}</a>)}
        </nav>
        {tree.breadcrumbs.length>0&&<nav class="subcategory-links" aria-label="Category breadcrumb">{tree.breadcrumbs.map(item=><a class="catalog-chip" href={browseHref(item.slug)} aria-current={category===item.slug?'page':undefined}>{item.label}</a>)}</nav>}
        {tree.children.length>0&&<nav class="subcategory-links" aria-label="Subcategories">{tree.children.map(item=><a class="catalog-chip" href={browseHref(item.slug)} aria-current={category===item.slug?'page':undefined}>{item.label}</a>)}</nav>}
        <p class="catalog-data-note">Published product details and available seller photos appear here as listings are added.</p>

        <div class="product-grid">
          {result.state === 'available' && pageProducts.map((product) => <ProductCard product={product} />)}

          {pageProducts.length === 0 && (
            <p class="product-empty-state">
              {result.state === 'error'
                ? 'The marketplace is temporarily unavailable. Please try again later.'
                : result.state==='invalid_request' ? 'These catalogue filters are not available. Clear the filters and choose a current category.'
                : result.state==='unconfigured' ? 'The marketplace connection is not configured. Published products cannot be loaded yet.'
                : (query || animal || category || minPriceRaw || maxPriceRaw)
                  ? 'No products in this category yet.'
                  : 'No published products yet. Check back when sellers add their listings.'}
              {' '}<a href="/services">Explore Pet &amp; Vet Services</a>
            </p>
          )}
        </div>
        {pageCount > 1 && <nav class="catalog-pagination" aria-label="Product pages">
          {page > 1 && <a class="button button-secondary small-button" href={browseHref(category,page-1)}>Previous</a>}
          <span>Page {page} of {pageCount}</span>
          {page < pageCount && <a class="button button-secondary small-button" href={browseHref(category,page+1)}>Next</a>}
        </nav>}
        {result.state==='available'&&<p class="catalog-count">{pageProducts.length} shown on this page · {result.pagination.total} matching product{result.pagination.total===1?'':'s'}{result.pagination.truncated?' (within the first 1,000 published listings)':''}</p>}
        <p class="sr-only" data-cart-status role="status" aria-live="polite"></p>
      </section>
    </main>
  </div>
  <script src="../../script.js"></script>
</body>
</html>
