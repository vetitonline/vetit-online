---
import '../../styles.css';
import SiteHeader from '../components/SiteHeader.astro';
import ProductCard from '../components/marketplace/ProductCard.astro';
import PhotoCategoryArt from '../components/marketplace/PhotoCategoryArt.astro';
import {readPublicCatalogueWindow} from '../lib/marketplace/catalogue-window';
import {buildCatalogueBrowseUrl,buildProductsUrl} from '../lib/marketplace/catalog-client.js';
import {categoryNavigation,categoriesForSpecies} from '../lib/marketplace/category-navigation.js';
import {catalogPriceRange} from '../lib/marketplace/catalog-contract.js';
const response=await readPublicCatalogueWindow(Astro.request,Astro.cookies);
const result=response.body;if(response.status!==200)Astro.response.status=response.status;
const params=Astro.url.searchParams;
const min=params.get('min')??'',max=params.get('max')??'';
const priceIssue=catalogPriceRange(min,max).issue;
const filters={query:result.filters.query,animal:result.filters.animal??undefined,category:result.filters.category??undefined,minPriceRupees:min,maxPriceRupees:max,pageSize:result.window.pageSize};
const href=(cursor?:string|null,category:string|null=filters.category??null)=>buildCatalogueBrowseUrl({...filters,category:category??undefined,cursor:cursor??undefined});
const tree=categoryNavigation(result.taxonomy.categories,result.taxonomy.animals.find(a=>a.slug===filters.animal)?.id,filters.category);
const categories=categoriesForSpecies(result.taxonomy.categories,result.taxonomy.animals.find(a=>a.slug===filters.animal)?.id);
---
<!DOCTYPE html>
<html lang="en"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1.0"/><title>Browse newest products | Vetit Online</title></head>
<body><div class="page-shell"><SiteHeader/><main><section class="product-showcase">
 <div class="product-heading"><div><span class="section-label dark-label"><span></span>Marketplace</span><h1>Browse newest products.</h1><p>Move through published products without page-number limits.</p></div></div>
 <nav class="catalog-species-selector" aria-label="Pets and livestock">
  <a class="catalog-chip" href={buildCatalogueBrowseUrl({...filters,animal:undefined,category:undefined})}>All pets &amp; livestock</a>
  {result.taxonomy.animals.map(animal=><a class:list={['catalog-species-card',filters.animal===animal.slug&&'active']} aria-current={filters.animal===animal.slug?'page':undefined} href={buildCatalogueBrowseUrl({...filters,animal:animal.slug,category:undefined})}><PhotoCategoryArt slug={animal.slug} label={animal.label}/><span>{animal.label}</span></a>)}
 </nav>
 <form class="catalog-filters" method="get" action="/browse" aria-label="Filter newest products">
  <label>Search products<input type="search" name="q" maxlength="100" value={filters.query} placeholder="Product, category or seller"/></label>
  <input type="hidden" name="animal" value={filters.animal??''}/><input type="hidden" name="pageSize" value={result.window.pageSize}/>
  <label>Category<select name="category"><option value="">All categories</option>{categories.map(category=><option value={category.slug} selected={filters.category===category.slug}>{category.label}</option>)}</select></label>
  <label>Min price (₹)<input type="number" name="min" min="0" step="0.01" inputmode="decimal" value={min} aria-invalid={priceIssue?.field==='min'?true:undefined} aria-describedby={priceIssue?'cursor-price-error':undefined}/></label>
  <label>Max price (₹)<input type="number" name="max" min="0" step="0.01" inputmode="decimal" value={max} aria-invalid={priceIssue?.field==='max'?true:undefined} aria-describedby={priceIssue?'cursor-price-error':undefined}/></label>
  <button class="button button-primary" type="submit">Apply filters</button><a class="catalog-clear" href="/browse">Clear filters</a>
  {priceIssue&&<p id="cursor-price-error" role="alert">{priceIssue.message} Your filters have been kept.</p>}
 </form>
 <nav class="subcategory-links" aria-label="Category navigation"><a class="catalog-chip" href={href(null,null)}>All categories</a>{tree.roots.map(category=><a class="catalog-chip" href={href(null,category.slug)}>{category.label}</a>)}</nav>
 {tree.breadcrumbs.length>0&&<nav class="subcategory-links" aria-label="Category breadcrumb">{tree.breadcrumbs.map(category=><a class="catalog-chip" href={href(null,category.slug)}>{category.label}</a>)}</nav>}
 {tree.children.length>0&&<nav class="subcategory-links" aria-label="Subcategories">{tree.children.map(category=><a class="catalog-chip" href={href(null,category.slug)}>{category.label}</a>)}</nav>}
 <p class="catalog-data-note">Newest first. Products can change while you browse. <a href={buildProductsUrl(filters)}>Use numbered pages and other sort options</a> · <a href="/services">Explore services</a></p>
 {result.state!=='available'?<p class="product-empty-state" role="status">{result.state==='unconfigured'?'Marketplace connection is not configured.':result.state==='invalid_request'?'These filters or this navigation link are no longer valid. Apply filters again or clear them.':'The marketplace is temporarily unavailable. Please try again later.'}</p>:<>
  <div class="product-grid">{result.products.map(product=><ProductCard product={product}/>)}</div>
  {result.products.length===0&&<p class="product-empty-state">No products in this window. <a href={href()}>Start again with these filters</a> or clear them.</p>}
  <nav class="catalog-pagination" aria-label="Newest product navigation">
   {result.window.previousCursor&&<a class="button button-secondary small-button" href={href(result.window.previousCursor)}>Previous</a>}
   <span>{result.products.length} products shown</span>
   {result.window.nextCursor&&<a class="button button-secondary small-button" href={href(result.window.nextCursor)}>Next</a>}
  </nav>
 </>}
 <p class="sr-only" data-cart-status role="status" aria-live="polite"></p>
</section></main></div><script src="../../script.js"></script></body></html>
