---
import logo from '../../Vetit-online-transparent.png';
import '../../styles.css';
const joining = Astro.url.searchParams.get('mode') === 'join';
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{joining ? 'Join Vetit Online' : 'Log in'} | Vetit Online</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&display=swap" rel="stylesheet">
</head>
<body>
  <div class="page-shell">
    <header class="site-header">
      <img src={logo.src} alt="Vetit Online">
      <nav class="main-nav" aria-label="Main navigation">
        <a href="/#marketplace">Marketplace</a>
        <a href="/#pet-care">Pet Care</a>
        <a href="/#livestock">Livestock</a>
        <a href="/#home-services">Services</a>
        <a href="/#how-it-works">How it works</a>
      </nav>
      <div class="header-actions">
        <a class="cart-link" href="/cart" aria-label="Shopping cart, 0 items" title="View your cart">
          <span class="cart-icon">🛒</span>
          <span class="cart-count">0</span>
        </a>
        <a class="login-link" href="/login">Log in</a>
        <a class="button button-primary small-button" href="/login?mode=join">Join free</a>
      </div>
    </header>

    <main class="auth-page">
      <section class="auth-card" aria-labelledby="auth-title">
        <span class="section-label dark-label"><span></span>Vetit Online account</span>
        <h1 id="auth-title">{joining ? 'Join Vetit for free' : 'Welcome back'}</h1>
        <p>{joining ? 'Create your account with email or an Indian mobile number.' : 'Log in securely with a one-time code.'}</p>

        <div class="auth-methods" data-auth-methods>
          <form class="auth-form" data-email-form>
            <label for="auth-email">Email address</label>
            <input id="auth-email" name="email" type="email" autocomplete="email" required placeholder="you@example.com">
            <button class="button button-primary" type="submit">Send email code</button>
          </form>
          <form class="auth-form" data-phone-form>
            <label for="auth-phone">Indian mobile number</label>
            <input id="auth-phone" name="phone" type="tel" autocomplete="tel-national" inputmode="tel" required placeholder="10-digit mobile number">
            <button class="button button-secondary" type="submit">Send SMS code</button>
          </form>
        </div>

        <form class="auth-form auth-verify" data-verify-form hidden>
          <p data-verify-prompt>Enter the one-time code we sent you.</p>
          <label for="auth-code">One-time code</label>
          <input id="auth-code" name="code" type="text" inputmode="numeric" autocomplete="one-time-code" pattern="[0-9]{6,8}" minlength="6" maxlength="8" required>
          <button class="button button-primary" type="submit">Verify and continue</button>
          <button class="auth-back" type="button" data-auth-back>Use a different email or phone</button>
        </form>

        <p class="auth-status" data-auth-status role="status" aria-live="polite"></p>
        <p class="auth-footnote">A first-time sign-in creates your customer account. Provider verification and seller onboarding are separate steps.</p>
        <a class="button button-ghost auth-home" href="/">Back to Vetit marketplace</a>
      </section>
    </main>
  </div>
  <script>
    import { createSupabaseBrowserClient } from '../lib/supabase/browser';
    import { sendEmailOtp, sendIndianPhoneOtp, verifyEmailOtp, verifyIndianPhoneOtp } from '../lib/auth/otp';

    const emailForm = document.querySelector('[data-email-form]');
    const phoneForm = document.querySelector('[data-phone-form]');
    const verifyForm = document.querySelector('[data-verify-form]');
    const methods = document.querySelector('[data-auth-methods]');
    const status = document.querySelector('[data-auth-status]');
    const verifyPrompt = document.querySelector('[data-verify-prompt]');
    let client;
    let challenge;

    function safeNextPath() {
      const requested = new URLSearchParams(window.location.search).get('next');
      return requested && requested.startsWith('/') && !requested.startsWith('//') ? requested : '/';
    }

    function showStatus(message, isError = false) {
      status.textContent = message;
      status.classList.toggle('is-error', isError);
    }

    function getClient() {
      if (!client) client = createSupabaseBrowserClient();
      return client;
    }

    function onError(error) {
      showStatus(error instanceof Error ? error.message : 'Authentication could not be completed. Please try again.', true);
    }

    async function requestCode(event, method) {
      event.preventDefault();
      const form = event.currentTarget;
      const value = new FormData(form).get(method === 'email' ? 'email' : 'phone');
      const contact = String(value || '').trim();
      if (!contact) return;

      const button = form.querySelector('button[type="submit"]');
      button.disabled = true;
      showStatus('Sending your one-time code…');
      try {
        const authClient = getClient();
        const { error } = method === 'email'
          ? await sendEmailOtp(authClient, contact)
          : await sendIndianPhoneOtp(authClient, contact);
        if (error) throw error;
        challenge = { method, contact };
        methods.hidden = true;
        verifyPrompt.textContent = `Enter the code sent to ${contact}. If your email contains a sign-in link, you can use that instead.`;
        verifyForm.hidden = false;
        document.querySelector('#auth-code').focus();
        showStatus('Check your email or SMS for the one-time code.');
      } catch (error) {
        onError(error);
      } finally {
        button.disabled = false;
      }
    }

    emailForm.addEventListener('submit', (event) => requestCode(event, 'email'));
    phoneForm.addEventListener('submit', (event) => requestCode(event, 'phone'));

    verifyForm.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!challenge) return;
      const button = verifyForm.querySelector('button[type="submit"]');
      button.disabled = true;
      showStatus('Verifying your code…');
      try {
        const token = String(new FormData(verifyForm).get('code') || '').trim();
        const authClient = getClient();
        const { error } = challenge.method === 'email'
          ? await verifyEmailOtp(authClient, challenge.contact, token)
          : await verifyIndianPhoneOtp(authClient, challenge.contact, token);
        if (error) throw error;
        showStatus('You are signed in. Redirecting…');
        window.location.replace(safeNextPath());
      } catch (error) {
        onError(error);
      } finally {
        button.disabled = false;
      }
    });

    document.querySelector('[data-auth-back]').addEventListener('click', () => {
      challenge = undefined;
      verifyForm.hidden = true;
      methods.hidden = false;
      showStatus('');
    });
  </script>
</body>
</html>
