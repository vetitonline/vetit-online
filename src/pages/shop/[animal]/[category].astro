---
import logo from '../../../../Vetit-online-transparent.png';
import '../../../../styles.css';
import ProductCard from '../../../components/marketplace/ProductCard.astro';
import { filterMarketplaceProducts } from '../../../lib/marketplace/catalog';
import { getMarketplaceProducts, getProductTaxonomy } from '../../../lib/marketplace/featured-products';
import { categoriesForAnimal, findAnimal, findCategory } from '../../../lib/marketplace/product-taxonomy';

const taxonomy = await getProductTaxonomy(Astro.request, Astro.cookies);
const animal = findAnimal(taxonomy.animals, Astro.params.animal ?? '');
const category = animal && findCategory(categoriesForAnimal(taxonomy.categories, animal), Astro.params.category ?? '');
if (!animal || !category) return Astro.redirect('/shop', 302);
const childIds = taxonomy.categories.filter((item) => item.parentId === category.id).map((item) => item.id);
const result = await getMarketplaceProducts(Astro.request, Astro.cookies, 1000, { speciesId: animal.id });
const products = filterMarketplaceProducts(result.products, { animal }).filter((product) => product.categoryId === category.id || childIds.includes(product.categoryId));
const childCategories = taxonomy.categories.filter((item) => item.parentId === category.id);
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{category.label} | Vetit Online</title>
  <link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&display=swap" rel="stylesheet">
</head>
<body><div class="page-shell">
  <header class="site-header"><a href="/" aria-label="Vetit Online home"><img src={logo.src} alt="Vetit Online"></a><nav class="main-nav" aria-label="Main navigation"><a href="/products">Marketplace</a><a href="/shop/dogs">Dogs</a><a href="/shop/cats">Cats</a><a href="/shop/livestock">Livestock</a><a href="/services">Services</a></nav><div class="header-actions"><a class="cart-link" href="/cart" aria-label="View your cart" title="View your cart"><span class="cart-icon">🛒</span><span class="cart-count">0</span></a><a class="login-link" href="/login">Log in</a><a class="button button-primary small-button" href="/login?mode=join">Join free</a></div></header>
  <main><section class="product-showcase">
    <div class="product-heading"><div><span class="section-label dark-label"><span></span><a href="/shop">All animals</a> / <a href={`/shop/${animal.slug}`}>{animal.label}</a></span><h1>{category.label}</h1><p>Published listings in {animal.label.toLocaleLowerCase()} {category.label.toLocaleLowerCase()}.</p></div><a class="product-view-all" href={`/shop/${animal.slug}`}>All {animal.label.toLocaleLowerCase()} categories →</a></div>
    {childCategories.length ? <nav class="subcategory-links" aria-label={`${category.label} subcategories`}>
      {childCategories.map((child) => <a class="catalog-chip" href={`/shop/${animal.slug}/${child.slug}`}>{child.label}</a>)}
    </nav> : null}
    <div class="product-grid">
      {result.state === 'available' && products.map((product) => <ProductCard product={product} />)}
      {result.state === 'error' && <p class="product-empty-state">The marketplace is temporarily unavailable. Please try again later.</p>}
      {result.state === 'unconfigured' && <p class="product-empty-state">Marketplace listings are not connected yet. No products are being shown.</p>}
      {result.state === 'available' && products.length === 0 && <p class="product-empty-state">No products in this category yet. <a href="/products">Browse all published products</a>.</p>}
    </div>
  </section></main>
</div><script src="../../../../script.js"></script></body>
</html>
