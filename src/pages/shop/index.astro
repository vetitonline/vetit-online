---
import logo from '../../../Vetit-online-transparent.png';
import '../../../styles.css';
import { PRODUCT_ANIMALS } from '../../lib/marketplace/product-taxonomy';
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Shop by animal | Vetit Online</title>
  <link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&display=swap" rel="stylesheet">
</head>
<body><div class="page-shell">
  <header class="site-header"><a href="/" aria-label="Vetit Online home"><img src={logo.src} alt="Vetit Online"></a><nav class="main-nav" aria-label="Main navigation"><a href="/#marketplace">Marketplace</a><a href="/shop/dogs">Dogs</a><a href="/shop/cats">Cats</a><a href="/shop/livestock">Livestock</a><a href="/services">Services</a></nav><div class="header-actions"><a class="cart-link" href="/cart" aria-label="View your cart" title="View your cart"><span class="cart-icon">🛒</span><span class="cart-count">0</span></a><a class="login-link" href="/login">Log in</a><a class="button button-primary small-button" href="/login?mode=join">Join free</a></div></header>
  <main><section class="product-showcase">
    <div class="product-heading"><div><span class="section-label dark-label"><span></span>Vetit marketplace</span><h1>Shop by animal.</h1><p>Browse published product listings for pets and livestock.</p></div></div>
    <div class="animal-category-grid">
      {PRODUCT_ANIMALS.map((animal) => <a class="animal-category-card" href={`/shop/${animal.slug}`}><span class="section-label dark-label"><span></span>Browse categories</span><h2>{animal.label}</h2><p>{animal.categories.map((category) => category.label).join(' · ')}</p><span class="category-link">Explore {animal.label.toLocaleLowerCase()} <span>→</span></span></a>)}
    </div>
    <p class="catalog-data-note">More animal categories can be added without changing the listing or cart data model.</p>
  </section></main>
</div><script src="../../../script.js"></script></body>
</html>
