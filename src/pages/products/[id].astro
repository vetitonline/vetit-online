---
import '../../../styles.css';
import { formatProductPrice, getMarketplaceProduct } from '../../lib/marketplace/featured-products';
import SiteHeader from '../../components/SiteHeader.astro';
import ProductPlaceholder from '../../components/marketplace/ProductPlaceholder.astro';

const productId = Astro.params.id ?? '';
const result = await getMarketplaceProduct(Astro.request, Astro.cookies, productId);
const product = result.product;
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{product ? `${product.title} | Vetit Online` : 'Product | Vetit Online'}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&display=swap" rel="stylesheet">
</head>
<body><div class="page-shell">
  <SiteHeader />
  <main><section class="product-showcase product-detail-page">
    {product ? <>
      <p class="product-breadcrumb"><a href="/products">Marketplace</a> / {product.category}</p>
      <div class="product-detail-layout">
        <div class="product-detail-image">{product.imageUrl ? <img src={product.imageUrl} alt={product.imageAlt ?? product.title}> : <ProductPlaceholder title={product.title} category={product.category} />}<span class="product-tag">{product.category}</span></div>
        <div class="product-detail-copy">
          <span class="section-label dark-label"><span></span>{product.category}</span>
          {product.brand && <p class="product-brand">{product.brand}</p>}
          <h1>{product.title}</h1>
          <p class="product-detail-seller">Sold by {product.sellerName}</p>
          <p class="product-detail-price">{formatProductPrice(product)}</p>
          {product.priceIsFrom && <p class="catalog-data-note">Price shown is the lowest current price across active variants. Variant selection is not available yet.</p>}
          <p class="product-detail-availability">Availability: Active published marketplace listing. Stock quantity is not provided.</p>
          <div class="product-description"><h2>Product details</h2><p>{product.description.trim() || 'The seller has not provided a product description.'}</p></div>
          <div class="product-detail-actions" data-cart-product data-product-id={product.id} data-product-title={product.title} data-product-category={product.category} data-product-seller={product.sellerName} data-product-image={product.imageUrl ?? ''} data-product-price-paise={product.priceMinor ?? ''}>
            <button class="button button-primary" type="button" data-add-to-cart disabled={product.priceIsFrom}>{product.priceIsFrom ? 'Variant options coming soon' : 'Add to cart'}</button>
            <a class="button button-secondary" href="/cart">View cart</a>
          </div>
          {!product.imageUrl && <p class="catalog-data-note">The seller has not published a public product image.</p>}
        </div>
      </div>
    </> : <div class="product-not-found">
      <span class="section-label dark-label"><span></span>Marketplace</span>
      <h1>{result.state === 'error' ? 'Product unavailable right now.' : 'This product is not available.'}</h1>
      <p>{result.state === 'unconfigured' ? 'The marketplace connection is not configured.' : 'Only active published India product listings can be viewed here.'}</p>
      <a class="button button-secondary" href="/products">Browse products</a>
    </div>}
    <p class="sr-only" data-cart-status role="status" aria-live="polite"></p>
  </section></main>
</div><script src="../../../script.js"></script></body>
</html>
