---
import heroImage from '../../vetit-online.jpeg';
import '../../styles.css';
import { formatPrice, getFeaturedProducts, getProductTaxonomy } from '../lib/marketplace/featured-products';
import SiteHeader from '../components/SiteHeader.astro';
import PhotoCategoryArt from '../components/marketplace/PhotoCategoryArt.astro';
import ProductPlaceholder from '../components/marketplace/ProductPlaceholder.astro';

const featuredProductsResult = await getFeaturedProducts(Astro.request, Astro.cookies);
const taxonomy = await getProductTaxonomy(Astro.request, Astro.cookies);
const browseGroups = taxonomy.categories.filter((category) => !category.parentId).map((root) => ({
  title: root.label,
  slug: root.slug,
  categories: taxonomy.categories.filter((category) => category.parentId === root.id),
}));
const visualGroups = browseGroups.slice(0, 4).map((group) => ({
  ...group,
  image: /livestock|farm|cattle/i.test(`${group.title} ${group.slug}`) ? 'livestock' : 'essentials',
  href: `/products?category=${encodeURIComponent(group.categories[0]?.slug ?? group.slug)}`,
}));
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Vetit | Marketplace</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&display=swap" rel="stylesheet">
</head>
<body>
  <div class="page-shell">
    <SiteHeader />

    <main>
      
        <section class="hero-section" id="marketplace">
          <div class="section-label">
            <span></span>
            Marketplace for pets &amp; livestock
          </div>
          <h1>Everything your pets &amp; livestock need.</h1>
          <p class="hero-text">Explore pet care, livestock essentials and local services, all in one welcoming marketplace.</p>

          <form class="marketplace-search" role="search">
            <label class="sr-only" for="marketplace-search">Search the marketplace</label>
            <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="6.5" fill="none" stroke="currentColor" stroke-width="2"></circle><path d="m16 16 5 5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path></svg>
            <input id="marketplace-search" type="search" placeholder="Search products, care or services" />
            <button class="search-button" type="submit">Search</button>
            <p class="search-status" data-search-status role="status" aria-live="polite" hidden></p>
          </form>

          <div class="hero-cta">
            <a class="button button-primary" href="/services">
              <span>Find trusted services</span>
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M5 12h14M13 3l9 9-9 9" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
              </svg>
            </a>
            <a class="button button-secondary" href="#featured-products">
              <span>Explore the marketplace</span>
            </a>
          </div>

          <div class="hero-proof">
            <div>
              <span class="proof-number">India</span>
              <span class="proof-label">first launch market</span>
            </div>
            <div>
              <span class="proof-number">Pets</span>
              <span class="proof-label">and livestock</span>
            </div>
            <div>
              <span class="proof-number">Local</span>
              <span class="proof-label">service discovery</span>
            </div>
          </div>
        <aside class="hero-panel" aria-label="Marketplace summary">
          <img class="hero-image" src={heroImage.src} alt="Vetit Online pets and livestock marketplace" />
          <div class="floating-card panel-top">
            <div class="panel-header">
              <span>
                <span class="panel-kicker">Marketplace preview</span>
                <span class="panel-date">Products &amp; services</span>
              </span>
              <span class="status-dot">
                <span></span>
                Preview
              </span>
            </div>

            <div class="match-score">
              <div>
                <span class="score-label">Discovery</span>
                <span class="score-value">India</span>
              </div>
              <div class="score-bars" aria-hidden="true">
                <span class="bar bar-1"></span>
                <span class="bar bar-2"></span>
                <span class="bar bar-3"></span>
                <span class="bar bar-4"></span>
                <span class="bar bar-5"></span>
              </div>
            </div>

            <div class="service-list">
              <div class="service-row">
                <span class="service-icon pet-icon">
                  <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3a7 7 0 0 0-6.7 4.2 6.8 6.8 0 0 0 2.2 8.4 7 7 0 0 0 8.8-.8A7 7 0 0 0 12 3z" fill="none" stroke="currentColor" stroke-width="2"></path><circle cx="8" cy="9" r="2" fill="currentColor"></circle><circle cx="16" cy="9" r="2" fill="currentColor"></circle><path d="M9.5 13.5c1.2 1.1 3.8 1.1 5 0" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path></svg>
                </span>
                <span class="service-detail">
                  <span class="service-title">Pet Care</span>
                  <span class="service-meta">Find pet services</span>
                </span>
                <span class="service-arrow">↗</span>
              </div>

              <div class="service-row">
                <span class="service-icon livestock-icon">
                  <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 18c4-3 6-7 8-12 2 4 4 7 8 10" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path><path d="M5 18h14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path></svg>
                </span>
                <span class="service-detail">
                  <span class="service-title">Livestock Health</span>
                  <span class="service-meta">Veterinary care</span>
                </span>
                <span class="service-arrow">↗</span>
              </div>

              <div class="service-row">
                <span class="service-icon service-icon">
                  <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 16h7l3-8 3 6h4l-3 5H4z" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"></path></svg>
                </span>
                <span class="service-detail">
                  <span class="service-title">Home Services</span>
                  <span class="service-meta">Local providers</span>
                </span>
                <span class="service-arrow">↗</span>
              </div>
            </div>
          </div>

          <div class="floating-card mini-card card-one">
            <span class="mini-card-title">Pet profiles</span>
            <span class="mini-card-icon">
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M4 14c2-4 5-6 8-6s5 2 7 5" fill="none" stroke="currentColor" stroke-width="2"></path>
                <path d="M6 18c2-2 4-4 9-4" fill="none" stroke="currentColor" stroke-width="2"></path>
              </svg>
            </span>
            <span class="mini-card-copy">Coming soon</span>
          </div>

          <div class="floating-card mini-card card-two">
            <span class="mini-card-title">Farm Plan</span>
            <span class="mini-card-copy positive">Coming soon</span>
          </div>
        </aside>
      </section>
      <section class="section categories-section discovery-section" id="browse-vetit">
        <div class="section-heading centered">
          <span class="section-label dark-label"><span></span>Browse Vetit</span>
          <h2>Find the right place to start.</h2>
        </div>
        <h3 class="discovery-subtitle">Shop by pet or livestock</h3>
        <div class="species-discovery-grid">
          {taxonomy.animals.map((animal) => <a class="species-discovery-card" href={`/shop/${animal.slug}`}><PhotoCategoryArt slug={animal.slug} label={animal.label} /><span class="species-discovery-name">{animal.slug === 'fish' ? 'Fish & Aquatics' : animal.slug === 'cattle' ? 'Livestock & Cattle' : animal.label}</span><span class="species-discovery-link">Explore <span aria-hidden="true">→</span></span></a>)}
          {taxonomy.state === 'error' && <p class="product-empty-state">Pet and livestock categories are temporarily unavailable.</p>}
        </div>
        {visualGroups.length > 0 && <div class="visual-discovery-grid" aria-label="Shop popular categories">
          {visualGroups.map((group) => <a class="visual-discovery-card" href={group.href}>
            <PhotoCategoryArt slug={group.image} label={group.title} />
            <span class="visual-discovery-shade"></span>
            <span class="visual-discovery-copy"><span>Explore Vetit</span><strong>{group.title}</strong><em>Browse category →</em></span>
          </a>)}
        </div>}
        <h3 class="discovery-subtitle">Browse product categories</h3>
        <div class="browse-group-grid">
          {browseGroups.map((group) => <section class="browse-group"><h4><a href={`/products?category=${encodeURIComponent(group.slug)}`}>{group.title}</a></h4><div class="browse-category-links">{group.categories.map((category) => {
            const animal = taxonomy.animals.find((item) => category.species.includes(item.id));
            const href = animal ? `/shop/${animal.slug}/${category.slug}` : `/products?category=${encodeURIComponent(category.slug)}`;
            return <a href={href}>{category.label}<span aria-hidden="true">→</span></a>;
          })}</div></section>)}
        </div>
        <div class="discovery-service-link"><span>Looking for professional help?</span><a href="/services">Explore Pet &amp; Vet Services →</a></div>
      </section>
      <section class="product-showcase" id="featured-products">

        <div class="product-heading">

          <div>

            <span class="section-label dark-label"><span></span>Featured products</span>

            <h2>Everything your pets &amp; livestock need.</h2>

            <p>Discover published products for pets, livestock and everyday care.</p>

          </div>

          <a class="product-view-all" href="/products">View all products <span>→</span></a>

        </div>

        <div class="product-grid">

          {featuredProductsResult.state === 'available' && featuredProductsResult.products.map((product) => (
            <article class="product-card" data-listing-id={product.id} data-cart-product data-product-id={product.id} data-product-title={product.title} data-product-category={product.category} data-product-seller={product.sellerName} data-product-image={product.imageUrl ?? ''} data-product-price-paise={product.priceMinor ?? ''}>
              <a class="product-card-image-link" href={`/products/${encodeURIComponent(product.id)}`} aria-label={`View ${product.title}`}><div class="product-image-wrap">
                {product.imageUrl ? <img src={product.imageUrl} alt={product.imageAlt ?? product.title} loading="lazy"> : <ProductPlaceholder title={product.title} category={product.category} />}
                <span class="product-tag">{product.category}</span>
              </div></a>
              <div class="product-info">
                <span class="product-seller">{product.sellerName}</span>
                <h3><a class="product-title-link" href={`/products/${encodeURIComponent(product.id)}`}>{product.title}</a></h3>
                <div class="product-bottom">
                  <strong>{formatPrice(product.priceMinor, product.currencyCode)}</strong>
                  <button type="button" data-add-to-cart aria-label={`Add ${product.title} to cart`} title={`Add ${product.title} to cart`}>+</button>
                </div>
              </div>
            </article>
          ))}

          {featuredProductsResult.state === 'available' && featuredProductsResult.products.length > 0 && featuredProductsResult.products.length < 4 && <article class="product-card product-discovery-card">
            <a class="product-discovery-link-card" href="/products" aria-label="Explore Pet Essentials in the marketplace">
              <div class="product-image-wrap">
                <PhotoCategoryArt slug="essentials" label="Unbranded pet food bowl, leash and toys" />
                <span class="product-tag">Explore Vetit</span>
              </div>
              <div class="product-info">
                <span class="product-seller">Browse the marketplace</span>
                <h3>Explore Pet Essentials</h3>
                <span class="product-discovery-cta">See all products <span aria-hidden="true">→</span></span>
              </div>
            </a>
          </article>}

          {featuredProductsResult.products.length === 0 && <p class="product-empty-state">{featuredProductsResult.state === 'error' ? 'The marketplace is temporarily unavailable. Please try again later.' : 'No published products are available yet.'} <a href="/products">Browse the marketplace</a></p>}


        </div>

        <p class="sr-only" data-cart-status role="status" aria-live="polite"></p>

      </section>
      <section class="partners-strip">
        <span>For pet &amp; livestock communities</span>
        <div class="strip-icons">
          <span class="strip-icon">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 12h6l3-7 3 14 3-7h6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg>
            Pet care
          </span>
          <span class="strip-icon">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 19L12 3l8 16H4z" fill="none" stroke="currentColor" stroke-width="2"></path></svg>
            Livestock care
          </span>
          <span class="strip-icon">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2C7 2 3 6 3 11c0 4 3 8 9 11 6-3 9-7 9-11 0-5-4-9-9-9z" fill="none" stroke="currentColor" stroke-width="2"></path></svg>
            Local services
          </span>
        </div>
      </section>

      <section class="section featured-section" id="insights">
        <div class="section-heading">
          <span class="section-label dark-label"><span></span>Explore Vetit</span>
          <h2>One welcoming place for everyday care.</h2>
        </div>
        <div class="feature-grid">
          <a class="feature-card feature-card-large feature-discovery-card" href="/shop">
            <div class="feature-badge">Pets &amp; livestock</div>
            <div class="feature-copy"><span class="feature-label">Marketplace</span><h3>Browse by who you care for.</h3><p>Explore Vetit’s product categories and see published listings when they are available.</p></div>
            <span class="feature-metrics">Browse categories →</span>
          </a>
          <a class="feature-card feature-discovery-card" href="/products">
            <div class="feature-badge orange">Shop products</div>
            <div class="feature-copy"><span class="feature-label">Product marketplace</span><h3>Find the right essentials.</h3></div>
            <span class="feature-metrics">View marketplace →</span>
          </a>
          <a class="feature-card feature-discovery-card" href="/services">
            <div class="feature-badge light">Local discovery</div>
            <div class="feature-copy"><span class="feature-label">Pet &amp; Vet Services</span><h3>Explore care near you.</h3></div>
            <span class="feature-metrics">Browse services →</span>
          </a>
        </div>
      </section>

      <section class="seller-section" id="seller">
        <div class="seller-mark">For sellers &amp; providers</div>
        <div class="seller-content">
          <div>
            <h2>Put your pet or livestock business in front of the right people.</h2>
            <p>List products, offer services, and grow with marketplace tools built for the pet &amp; livestock community.</p>
          </div>
          <span class="button button-light" aria-disabled="true" title="Seller registration is not available yet">Start selling <span>↗</span></span>
        </div>
        <div class="seller-points">
          <span><b>01</b> Reach more customers</span>
          <span><b>02</b> Manage everything in one place</span>
          <span><b>03</b> Marketplace insights planned</span>
        </div>
      </section>

      <section class="section workflow-section" id="how-it-works">
        <div class="workflow-grid">
          <div class="workflow-copy">
            <span class="section-label dark-label"><span></span>How it works</span>
            <h2>From discovery to care, designed around the pets &amp; livestock you love.</h2>
            <p>Search published services by category, city and locality. Provider recommendations and distance search are planned for a later phase.</p>
            <div class="workflow-list">
              <div class="workflow-step">
                <span class="workflow-number">01</span>
                <div>
                  <span class="workflow-title">Describe the need</span>
                  <span class="workflow-text">Tell the platform what your pet, herd, or property needs.</span>
                </div>
              </div>
              <div class="workflow-step">
                <span class="workflow-number">02</span>
                <div>
                  <span class="workflow-title">Get matched</span>
                  <span class="workflow-text">Provider opening hours and appointment availability will appear as providers publish them.</span>
                </div>
              </div>
              <div class="workflow-step">
                <span class="workflow-number">03</span>
                <div>
                  <span class="workflow-title">Book with confidence</span>
                  <span class="workflow-text">Provider discovery is available. Appointment requests and care management are coming soon.</span>
                </div>
              </div>
            </div>
            <span class="button button-secondary dark-button" aria-disabled="true" title="Care requests are not available yet">
              <span>Care requests coming soon</span>
            </span>
          </div>

          <div class="workflow-panel">
            <div class="workflow-card">
              <div class="workflow-card-top">
                <span class="workflow-card-title">Booking flow preview</span>
                <span class="workflow-card-status">
                  <span></span>
                  Preview only
                </span>
              </div>

              <div class="request-detail">
                <span class="request-label">Need</span>
                <span class="request-value">Pet health check</span>
              </div>

              <div class="request-detail">
                <span class="request-label">Location</span>
                <span class="request-value">Greenfield District</span>
              </div>

              <div class="request-progress">
              <div class="progress-top">
                  <span>Illustrative provider card layout</span>
                  <span class="progress-percent">Preview</span>
                </div>
                <div class="progress-bar">
                  <span class="progress-fill"></span>
                </div>
              </div>

              <div class="provider-grid">
                <div class="provider-card">
                  <span class="provider-avatar">V</span>
                  <span class="provider-name">Veterinary provider</span>
                  <span class="provider-meta">Example only</span>
                </div>
                <div class="provider-card selected">
                  <span class="provider-avatar">L</span>
                  <span class="provider-name">Livestock provider</span>
                  <span class="provider-meta">Example only</span>
                </div>
              </div>

              <div class="request-actions">
                <span class="button button-primary small-button" aria-disabled="true" title="Booking requests are not available yet">Appointments coming soon</span>
                <span class="button button-ghost small-button" aria-disabled="true" title="Provider comparison is not available yet">Comparison coming soon</span>
              </div>
            </div>
          </div>
        </div>
      </section>

      <section class="section stats-section">
        <div class="stats-grid">
          <article class="stat-card">
            <span class="stat-number">Local</span>
            <span class="stat-label">Service discovery</span>
          </article>
          <article class="stat-card">
            <span class="stat-number">Pet</span>
            <span class="stat-label">Products &amp; care</span>
          </article>
          <article class="stat-card">
            <span class="stat-number">Farm</span>
            <span class="stat-label">Livestock services</span>
          </article>
          <article class="stat-card">
            <span class="stat-number">India</span>
            <span class="stat-label">First launch market</span>
          </article>
        </div>
      </section>

      <section class="section cta-section">
        <div class="cta-card">
          <div>
            <span class="section-label dark-label"><span></span>Join the network</span>
            <h2>Build a healthier future for pets &amp; livestock.</h2>
            <p>For local providers, farmers, pet parents, and communities building healthier care journeys.</p>
          </div>
          <div class="cta-actions">
            <span class="button button-primary" aria-disabled="true" title="Provider onboarding is not available yet">Provider onboarding coming soon</span>
            <span class="button button-secondary dark-button" aria-disabled="true" title="Marketplace access requests are not available yet">Marketplace access coming soon</span>
          </div>
        </div>
      </section>
    </main>

    <footer class="site-footer">
      <div class="footer-brand">
        <a class="brand" href="/" aria-label="Vetit Online home">
          <span class="brand-icon">
            <svg viewBox="0 0 40 40" aria-hidden="true">
              <path d="M20 3C9.9 3 2 10.9 2 20s7.9 17 18 17 18-7.9 18-17S30.1 3 20 3z" fill="none" stroke="currentColor" stroke-width="2"></path>
              <path d="M14 21c2.8-6.6 8.9-8.7 13-4.5 2.3 2.3 2.5 6.1.5 8.5-2.4 2.9-6.5 3.3-9 1.2-1.9-1.7-2.4-2.9-4.5-5.2z" fill="currentColor" opacity=".95"></path>
            </svg>
          </span>
          <span class="brand-text">
            <span class="brand-title">vetit</span><span class="brand-subtitle">online</span>
          </span>
        </a>
        <span class="footer-copy">Pet, livestock and care services marketplace</span>
      </div>
      <nav class="footer-links">
        <a href="/products">Marketplace</a>
        <a href="/services">Care services</a>
        <a href="/shop/livestock">Livestock</a>
        <a href="/login?mode=join">Providers</a>
        <a href="#insights">Insights</a>
      </nav>
      <span class="footer-social" role="img" aria-label="Vetit social link is not available yet" title="Vetit social link is not available yet">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 12a8 8 0 0 1 8-8 8 8 0 0 1 8 8 8 8 0 0 1-8 8 8 8 0 0 1-8-8z" fill="none" stroke="currentColor" stroke-width="2"></path><path d="M8 12h8m-4-4v8" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path></svg>
      </span>
    </footer>
  </div>
    

  <script src="../../script.js"></script>
</body>
</html>
