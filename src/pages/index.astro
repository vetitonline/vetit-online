---
import logo from '../../Vetit-online-transparent.png';
import '../../styles.css';
import { formatPrice, getFeaturedProducts } from '../lib/marketplace/featured-products';

const featuredProductsResult = await getFeaturedProducts(Astro.cookies);
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Vetit | Marketplace</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&display=swap" rel="stylesheet">
</head>
<body>
  <div class="page-shell">
    <header class="site-header">
     <img src={logo.src} alt="Vetit Online">
      <nav class="main-nav" aria-label="Main navigation">

  <a class="active" href="#marketplace">Marketplace</a>

  <a href="#pet-care">Pet Care</a>

  <a href="#livestock">Livestock</a>

  <a href="#home-services">Services</a>

  <a href="#how-it-works">How it works</a>

</nav>

      
        <div class="header-actions">

  <a class="cart-link" href="/cart" aria-label="Shopping cart, 0 items" title="View your cart">

    <span class="cart-icon">🛒</span>

    <span class="cart-count">0</span>

  </a>

  <a class="login-link" href="/login">Log in</a>
        
        <a class="button button-primary small-button" href="/login?mode=join">Join free</a>
      </div>
    </header>

    <main>
      
        <section class="hero-section" id="marketplace">
          <div class="section-label">
            <span></span>
            Marketplace for every animal journey
          </div>
          <h1>Care, commerce, and services for every animal journey.</h1>
          <p class="hero-text">Shop for pets and livestock, discover animal-care services, and find useful support for every animal journey.</p>

          <form class="marketplace-search" role="search">
            <label class="sr-only" for="marketplace-search">Search the marketplace</label>
            <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="6.5" fill="none" stroke="currentColor" stroke-width="2"></circle><path d="m16 16 5 5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path></svg>
            <input id="marketplace-search" type="search" placeholder="Search products, care or services" />
            <button class="search-button" type="submit">Search</button>
            <p class="search-status" data-search-status role="status" aria-live="polite" hidden></p>
          </form>

          <div class="hero-cta">
            <a class="button button-primary" href="#home-services">
              <span>Find trusted services</span>
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M5 12h14M13 3l9 9-9 9" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
              </svg>
            </a>
            <a class="button button-secondary" href="#featured-products">
              <span>Explore the marketplace</span>
            </a>
          </div>

          <div class="hero-proof">
            <div>
              <span class="proof-number">India</span>
              <span class="proof-label">first launch market</span>
            </div>
            <div>
              <span class="proof-number">Pets</span>
              <span class="proof-label">and livestock</span>
            </div>
            <div>
              <span class="proof-number">Local</span>
              <span class="proof-label">service discovery</span>
            </div>
          </div>
        <aside class="hero-panel" aria-label="Marketplace summary">
          <div class="floating-card panel-top">
            <div class="panel-header">
              <span>
                <span class="panel-kicker">Marketplace preview</span>
                <span class="panel-date">Products &amp; services</span>
              </span>
              <span class="status-dot">
                <span></span>
                Preview
              </span>
            </div>

            <div class="match-score">
              <div>
                <span class="score-label">Discovery</span>
                <span class="score-value">India</span>
              </div>
              <div class="score-bars" aria-hidden="true">
                <span class="bar bar-1"></span>
                <span class="bar bar-2"></span>
                <span class="bar bar-3"></span>
                <span class="bar bar-4"></span>
                <span class="bar bar-5"></span>
              </div>
            </div>

            <div class="service-list">
              <div class="service-row">
                <span class="service-icon pet-icon">
                  <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3a7 7 0 0 0-6.7 4.2 6.8 6.8 0 0 0 2.2 8.4 7 7 0 0 0 8.8-.8A7 7 0 0 0 12 3z" fill="none" stroke="currentColor" stroke-width="2"></path><circle cx="8" cy="9" r="2" fill="currentColor"></circle><circle cx="16" cy="9" r="2" fill="currentColor"></circle><path d="M9.5 13.5c1.2 1.1 3.8 1.1 5 0" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path></svg>
                </span>
                <span class="service-detail">
                  <span class="service-title">Pet Care</span>
                  <span class="service-meta">Find pet services</span>
                </span>
                <span class="service-arrow">↗</span>
              </div>

              <div class="service-row">
                <span class="service-icon livestock-icon">
                  <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 18c4-3 6-7 8-12 2 4 4 7 8 10" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path><path d="M5 18h14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path></svg>
                </span>
                <span class="service-detail">
                  <span class="service-title">Livestock Health</span>
                  <span class="service-meta">Veterinary care</span>
                </span>
                <span class="service-arrow">↗</span>
              </div>

              <div class="service-row">
                <span class="service-icon service-icon">
                  <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 16h7l3-8 3 6h4l-3 5H4z" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"></path></svg>
                </span>
                <span class="service-detail">
                  <span class="service-title">Home Services</span>
                  <span class="service-meta">Local providers</span>
                </span>
                <span class="service-arrow">↗</span>
              </div>
            </div>
          </div>

          <div class="floating-card mini-card card-one">
            <span class="mini-card-title">Pet profiles</span>
            <span class="mini-card-icon">
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M4 14c2-4 5-6 8-6s5 2 7 5" fill="none" stroke="currentColor" stroke-width="2"></path>
                <path d="M6 18c2-2 4-4 9-4" fill="none" stroke="currentColor" stroke-width="2"></path>
              </svg>
            </span>
            <span class="mini-card-copy">Coming soon</span>
          </div>

          <div class="floating-card mini-card card-two">
            <span class="mini-card-title">Farm Plan</span>
            <span class="mini-card-copy positive">Coming soon</span>
          </div>
        </aside>
      </section>
      <section class="product-showcase" id="featured-products">

        <div class="product-heading">

          <div>

            <span class="section-label dark-label"><span></span>Featured products</span>

            <h2>Shop what your animals need.</h2>

            <p>Discover products from Vetit sellers for pets, livestock and everyday animal care.</p>

          </div>

          <a class="product-view-all" href="/products">View all products <span>→</span></a>

        </div>

        <div class="product-grid">

          {featuredProductsResult.state === 'available' && featuredProductsResult.products.map((product) => (
            <article class="product-card" data-listing-id={product.id} data-cart-product data-product-id={product.id} data-product-title={product.title} data-product-category={product.category} data-product-seller={product.sellerName} data-product-image={product.imageUrl} data-product-price-paise={product.pricePaise ?? ''}>
              <a class="product-card-image-link" href={`/products/${encodeURIComponent(product.id)}`} aria-label={`View ${product.title}`}><div class="product-image-wrap">
                <img src={product.imageUrl} alt={product.title} loading="lazy">
                <span class="product-tag">{product.category}</span>
              </div></a>
              <div class="product-info">
                <span class="product-seller">{product.sellerName}</span>
                <h3><a class="product-title-link" href={`/products/${encodeURIComponent(product.id)}`}>{product.title}</a></h3>
                <div class="product-bottom">
                  <strong>{formatPrice(product.pricePaise)}</strong>
                  <button type="button" data-add-to-cart aria-label={`Add ${product.title} to cart`} title={`Add ${product.title} to cart`}>+</button>
                </div>
              </div>
            </article>
          ))}

          {featuredProductsResult.products.length === 0 && <>

          <article class="product-card" data-cart-product data-product-id="sample-premium-dog-nutrition" data-product-title="Premium dog nutrition" data-product-category="Pet food" data-product-seller="Featured seller" data-product-image="https://images.unsplash.com/photo-1589924691995-400dc9ecc119?auto=format&fit=crop&w=800&q=80" data-product-price-paise="89900">

            <div class="product-image-wrap">

              <a class="product-card-image-link" href="/shop/dogs" aria-label="Shop dog products"><img src="https://images.unsplash.com/photo-1589924691995-400dc9ecc119?auto=format&fit=crop&w=800&q=80" alt="Dog food and pet supplies"></a>

              <span class="product-tag">Pet food</span>

            </div>

            <div class="product-info">

              <span class="product-seller">Featured seller</span>

              <h3><a class="product-title-link" href="/shop/dogs">Premium dog nutrition</a></h3>

              <div class="product-bottom">

                <strong>From ₹899</strong>

              <button type="button" data-add-to-cart aria-label="Add Premium dog nutrition to cart" title="Add Premium dog nutrition to cart">+</button>

              </div>

            </div>

          </article>

          <article class="product-card" data-cart-product data-product-id="sample-cat-wellness-essentials" data-product-title="Cat wellness essentials" data-product-category="Cat care" data-product-seller="Featured seller" data-product-image="https://images.unsplash.com/photo-1514888286974-6c03e2ca1dba?auto=format&fit=crop&w=800&q=80" data-product-price-paise="49900">

            <div class="product-image-wrap">

              <a class="product-card-image-link" href="/shop/cats" aria-label="Shop cat products"><img src="https://images.unsplash.com/photo-1514888286974-6c03e2ca1dba?auto=format&fit=crop&w=800&q=80" alt="Cat care and wellness"></a>

              <span class="product-tag">Cat care</span>

            </div>

            <div class="product-info">

              <span class="product-seller">Featured seller</span>

              <h3><a class="product-title-link" href="/shop/cats">Cat wellness essentials</a></h3>

              <div class="product-bottom">

                <strong>From ₹499</strong>

              <button type="button" data-add-to-cart aria-label="Add Cat wellness essentials to cart" title="Add Cat wellness essentials to cart">+</button>

              </div>

            </div>

          </article>

          <article class="product-card" data-cart-product data-product-id="sample-playtime-favourites" data-product-title="Playtime favourites" data-product-category="Toys" data-product-seller="Featured seller" data-product-image="https://images.unsplash.com/photo-1601758228041-f3b2795255f1?auto=format&fit=crop&w=800&q=80" data-product-price-paise="29900">

            <div class="product-image-wrap">

              <a class="product-card-image-link" href="/shop/dogs/toys" aria-label="Shop pet toys"><img src="https://images.unsplash.com/photo-1601758228041-f3b2795255f1?auto=format&fit=crop&w=800&q=80" alt="Pet toys and accessories"></a>

              <span class="product-tag">Toys</span>

            </div>

            <div class="product-info">

              <span class="product-seller">Featured seller</span>

              <h3><a class="product-title-link" href="/shop/dogs/toys">Playtime favourites</a></h3>

              <div class="product-bottom">

                <strong>From ₹299</strong>

              <button type="button" data-add-to-cart aria-label="Add Playtime favourites to cart" title="Add Playtime favourites to cart">+</button>

              </div>

            </div>

          </article>

          <article class="product-card" data-cart-product data-product-id="sample-livestock-essentials" data-product-title="Livestock essentials" data-product-category="Livestock" data-product-seller="Featured seller" data-product-image="https://images.unsplash.com/photo-1500595046743-cd271d694d30?auto=format&fit=crop&w=800&q=80" data-product-price-paise="">

            <div class="product-image-wrap">

              <a class="product-card-image-link" href="/shop/livestock" aria-label="Shop livestock products"><img src="https://images.unsplash.com/photo-1500595046743-cd271d694d30?auto=format&fit=crop&w=800&q=80" alt="Livestock and farm"></a>

              <span class="product-tag">Livestock</span>

            </div>

            <div class="product-info">

              <span class="product-seller">Featured seller</span>

              <h3><a class="product-title-link" href="/shop/livestock">Livestock essentials</a></h3>

              <div class="product-bottom">

                <strong>Shop farm supplies</strong>

              <button type="button" data-add-to-cart aria-label="Add Livestock essentials to cart" title="Add Livestock essentials to cart">+</button>

              </div>

            </div>

          </article>

          </>}

        </div>

        <p class="sr-only" data-cart-status role="status" aria-live="polite"></p>

      </section>
      <section class="partners-strip">
        <span>For animal-care communities</span>
        <div class="strip-icons">
          <span class="strip-icon">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 12h6l3-7 3 14 3-7h6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg>
            Pet care
          </span>
          <span class="strip-icon">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 19L12 3l8 16H4z" fill="none" stroke="currentColor" stroke-width="2"></path></svg>
            Livestock care
          </span>
          <span class="strip-icon">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2C7 2 3 6 3 11c0 4 3 8 9 11 6-3 9-7 9-11 0-5-4-9-9-9z" fill="none" stroke="currentColor" stroke-width="2"></path></svg>
            Local services
          </span>
        </div>
      </section>

      <section class="section categories-section">
        <div class="section-heading centered">
          <span class="section-label dark-label"><span></span>Marketplace categories</span>
          <h2>Better support for every kind of care.</h2>
        </div>
        <div class="category-grid">
          <article class="category-card" id="pet-care">
            <span class="category-icon">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 19c2-6 5-9 8-9s5 3 7 9" fill="none" stroke="currentColor" stroke-width="2"></path><circle cx="12" cy="5" r="3" fill="none" stroke="currentColor" stroke-width="2"></circle></svg>
            </span>
            <span class="category-title">Pet wellness</span>
            <span class="category-copy">Veterinary care, grooming, nutrition, walking and companionship.</span>
            <a class="category-link" href="/services">Find pet services <span>→</span></a>
          </article>
          <article class="category-card" id="livestock">
            <span class="category-icon">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 18c4-6 7-7 11-7 2 3 3 5 4 7" fill="none" stroke="currentColor" stroke-width="2"></path><path d="M8 8c1-3 3-4 5-4 2 0 4 2 4 4" fill="none" stroke="currentColor" stroke-width="2"></path></svg>
            </span>
            <span class="category-title">Livestock care</span>
            <span class="category-copy">Farm health planning, pasture advice, vaccination and daily care.</span>
            <a class="category-link" href="/services?category=livestock-veterinary">Find livestock care <span>→</span></a>
          </article>
          <article class="category-card" id="home-services">
            <span class="category-icon">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 17h16M6 17V9m6 8V7m6 10V5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path></svg>
            </span>
            <span class="category-title">Home services</span>
            <span class="category-copy">Pet sitting, farmside support, transport and trusted local experts.</span>
           <a class="category-link" href="/services">Explore home care <span>→</span></a>
          </article>
          <article class="category-card category-card-accent" id="animal-products">
            <span class="category-icon">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16v13H4zM7 7V5a2 2 0 0 1 2-2h6a2 2 0 0 1 2 2v2" fill="none" stroke="currentColor" stroke-width="2"></path><path d="M8 12h8m-4-3v6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path></svg>
            </span>
            <span class="category-title">Animal products</span>
            <span class="category-copy">Quality feed, farm equipment, wellness essentials and everyday pet supplies.</span>
            <a href="#featured-products" class="category-link">Shop products <span>→</span></a>
          </article>
        </div>
      </section>

      <section class="section featured-section" id="insights">
        <div class="section-heading">
          <span class="section-label dark-label"><span></span>Popular right now</span>
          <h2>Fresh finds for pets, farms, and family routines.</h2>
        </div>

        <div class="feature-grid">
          <article class="feature-card feature-card-large">
            <div class="feature-badge">Best seller</div>
            <div class="feature-copy">
              <span class="feature-label">Pet wellness</span>
              <h3>Smart care kits for healthier everyday routines.</h3>
              <p>Nutrition bundles, preventive treatments, and wellness supplies curated by local veterinarians.</p>
            </div>
            <div class="feature-metrics">
              <span>4.9 rating</span>
              <span>2.4k orders</span>
            </div>
          </article>

          <article class="feature-card">
            <div class="feature-badge orange">Farm ready</div>
            <div class="feature-copy">
              <span class="feature-label">Livestock</span>
              <h3>Seasonal herd health plans.</h3>
            </div>
            <ul class="feature-list">
              <li>Vaccination support</li>
              <li>Pasture planning</li>
              <li>Daily care check-ins</li>
            </ul>
          </article>

          <article class="feature-card">
            <div class="feature-badge light">Local care</div>
            <div class="feature-copy">
              <span class="feature-label">Services</span>
              <h3>Trusted sitters and mobile visits.</h3>
            </div>
            <ul class="feature-list">
              <li>Appointments coming soon</li>
              <li>Verified providers</li>
              <li>AI care tools coming soon</li>
            </ul>
          </article>
        </div>
      </section>

      <section class="seller-section" id="seller">
        <div class="seller-mark">For sellers &amp; providers</div>
        <div class="seller-content">
          <div>
            <h2>Put your animal business in front of the right people.</h2>
            <p>List products, offer services, and grow with marketplace tools built for the animal care community.</p>
          </div>
          <span class="button button-light" aria-disabled="true" title="Seller registration is not available yet">Start selling <span>↗</span></span>
        </div>
        <div class="seller-points">
          <span><b>01</b> Reach more customers</span>
          <span><b>02</b> Manage everything in one place</span>
          <span><b>03</b> Marketplace insights planned</span>
        </div>
      </section>

      <section class="section workflow-section" id="how-it-works">
        <div class="workflow-grid">
          <div class="workflow-copy">
            <span class="section-label dark-label"><span></span>How it works</span>
            <h2>From discovery to care, designed around the animals you love.</h2>
            <p>Search published services by category, city and locality. Provider recommendations and distance search are planned for a later phase.</p>
            <div class="workflow-list">
              <div class="workflow-step">
                <span class="workflow-number">01</span>
                <div>
                  <span class="workflow-title">Describe the need</span>
                  <span class="workflow-text">Tell the platform what your pet, herd, or property needs.</span>
                </div>
              </div>
              <div class="workflow-step">
                <span class="workflow-number">02</span>
                <div>
                  <span class="workflow-title">Get matched</span>
                  <span class="workflow-text">Provider opening hours and appointment availability will appear as providers publish them.</span>
                </div>
              </div>
              <div class="workflow-step">
                <span class="workflow-number">03</span>
                <div>
                  <span class="workflow-title">Book with confidence</span>
                  <span class="workflow-text">Provider discovery is available. Appointment requests and care management are coming soon.</span>
                </div>
              </div>
            </div>
            <span class="button button-secondary dark-button" aria-disabled="true" title="Care requests are not available yet">
              <span>Care requests coming soon</span>
            </span>
          </div>

          <div class="workflow-panel">
            <div class="workflow-card">
              <div class="workflow-card-top">
                <span class="workflow-card-title">Booking flow preview</span>
                <span class="workflow-card-status">
                  <span></span>
                  Preview only
                </span>
              </div>

              <div class="request-detail">
                <span class="request-label">Need</span>
                <span class="request-value">Pet health check</span>
              </div>

              <div class="request-detail">
                <span class="request-label">Location</span>
                <span class="request-value">Greenfield District</span>
              </div>

              <div class="request-progress">
              <div class="progress-top">
                  <span>Illustrative provider card layout</span>
                  <span class="progress-percent">Preview</span>
                </div>
                <div class="progress-bar">
                  <span class="progress-fill"></span>
                </div>
              </div>

              <div class="provider-grid">
                <div class="provider-card">
                  <span class="provider-avatar">V</span>
                  <span class="provider-name">Veterinary provider</span>
                  <span class="provider-meta">Example only</span>
                </div>
                <div class="provider-card selected">
                  <span class="provider-avatar">L</span>
                  <span class="provider-name">Livestock provider</span>
                  <span class="provider-meta">Example only</span>
                </div>
              </div>

              <div class="request-actions">
                <span class="button button-primary small-button" aria-disabled="true" title="Booking requests are not available yet">Appointments coming soon</span>
                <span class="button button-ghost small-button" aria-disabled="true" title="Provider comparison is not available yet">Comparison coming soon</span>
              </div>
            </div>
          </div>
        </div>
      </section>

      <section class="section stats-section">
        <div class="stats-grid">
          <article class="stat-card">
            <span class="stat-number">Local</span>
            <span class="stat-label">Service discovery</span>
          </article>
          <article class="stat-card">
            <span class="stat-number">Pet</span>
            <span class="stat-label">Products &amp; care</span>
          </article>
          <article class="stat-card">
            <span class="stat-number">Farm</span>
            <span class="stat-label">Livestock services</span>
          </article>
          <article class="stat-card">
            <span class="stat-number">India</span>
            <span class="stat-label">First launch market</span>
          </article>
        </div>
      </section>

      <section class="section cta-section">
        <div class="cta-card">
          <div>
            <span class="section-label dark-label"><span></span>Join the network</span>
            <h2>Build a healthier future for every animal.</h2>
            <p>For local providers, farmers, pet parents, and communities building healthier animal care journeys.</p>
          </div>
          <div class="cta-actions">
            <span class="button button-primary" aria-disabled="true" title="Provider onboarding is not available yet">Provider onboarding coming soon</span>
            <span class="button button-secondary dark-button" aria-disabled="true" title="Marketplace access requests are not available yet">Marketplace access coming soon</span>
          </div>
        </div>
      </section>
    </main>

    <footer class="site-footer">
      <div class="footer-brand">
