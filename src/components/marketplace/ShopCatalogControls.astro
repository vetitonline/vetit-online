---
import {catalogPriceRange} from '../../lib/marketplace/catalog-contract.js';
import {buildShopCatalogUrl} from '../../lib/marketplace/shop-navigation.js';
import type {CatalogApiResponse} from '../../lib/marketplace/catalog-client.js';
interface Props{animal:string;category?:string;params:URLSearchParams;pagination:CatalogApiResponse['pagination'];position:'filters'|'pagination';available:boolean;}
const {animal,category,params,pagination,position,available}=Astro.props;
const priceIssue=catalogPriceRange(params.get('min'),params.get('max')).issue;
const href=(page?:number)=>buildShopCatalogUrl(animal,category,params,page);
---
{position==='filters'?<form class="catalog-filters" method="get" action={buildShopCatalogUrl(animal,category)} aria-label="Filter published products">
 <label>Search<input type="search" name="q" value={params.get('q')??''} maxlength="100" placeholder="Product, category or seller" /></label>
 <label>Min price (₹)<input type="number" name="min" aria-invalid={priceIssue?.field==='min'?true:undefined} aria-describedby={priceIssue?'catalog-price-error':undefined} min="0" step="0.01" value={params.get('min')??''} inputmode="decimal" /></label>
 <label>Max price (₹)<input type="number" name="max" aria-invalid={priceIssue?.field==='max'?true:undefined} aria-describedby={priceIssue?'catalog-price-error':undefined} min="0" step="0.01" value={params.get('max')??''} inputmode="decimal" /></label>
 <label>Sort by<select name="sort">{[['newest','Newest'],['price-asc','Price: low to high'],['price-desc','Price: high to low'],['name','Name']].map(([value,label])=><option value={value} selected={(params.get('sort')??'newest')===value}>{label}</option>)}</select></label>
 <input type="hidden" name="pageSize" value={pagination.pageSize} />
 <button class="button button-primary" type="submit">Apply filters</button><a class="catalog-clear" href={buildShopCatalogUrl(animal,category)}>Clear filters</a>
{priceIssue&&<p id="catalog-price-error" role="alert">{priceIssue.message} Your filters have been kept; correct the range and apply again.</p>}
</form>:available&&<>
 {pagination.pageCount>1&&<nav class="catalog-pagination" aria-label="Product pages">
  {pagination.hasPrevious&&<a class="button button-secondary small-button" href={href(pagination.page-1)}>Previous</a>}
  <span>Page {pagination.page} of {pagination.pageCount}</span>
  {pagination.hasNext&&<a class="button button-secondary small-button" href={href(pagination.page+1)}>Next</a>}
 </nav>}
 <p class="catalog-count">{pagination.total} matching product{pagination.total===1?'':'s'}{pagination.truncated?' (within the first 1,000 published listings)':''}</p>
</>}
