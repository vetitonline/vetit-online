---
import type { FeaturedProduct } from '../../lib/marketplace/featured-products';
import { formatPrice } from '../../lib/marketplace/featured-products';

interface Props {
  product: FeaturedProduct;
}

const { product } = Astro.props;
const detailHref = `/products/${encodeURIComponent(product.id)}`;
---
<article class="product-card" data-listing-id={product.id} data-cart-product data-product-id={product.id} data-product-title={product.title} data-product-category={product.category} data-product-seller={product.sellerName} data-product-image={product.imageUrl} data-product-price-paise={product.pricePaise ?? ''}>
  <a class="product-card-image-link" href={detailHref} aria-label={`View ${product.title}`}>
    <div class="product-image-wrap">
      <img src={product.imageUrl} alt={`${product.category} category image`} loading="lazy">
      <span class="product-tag">{product.category}</span>
    </div>
  </a>
  <div class="product-info">
    {product.brand && <span class="product-brand">{product.brand}</span>}
    <span class="product-seller">{product.sellerName}</span>
    <h2><a href={detailHref}>{product.title}</a></h2>
    <div class="product-bottom">
      <strong>{formatPrice(product.pricePaise)}</strong>
      <button type="button" data-add-to-cart aria-label={`Add ${product.title} to cart`} title={`Add ${product.title} to cart`}>+</button>
    </div>
  </div>
</article>
