---
import {marketplaceDestinations} from '../../lib/marketplace/navigation.js';
import PhotoCategoryArt from './PhotoCategoryArt.astro';
---
<nav class="home-shortcuts" aria-label="Explore Vetit">
  {marketplaceDestinations().map(tile=><a class="home-shortcut" href={tile.href} data-destination={tile.key}>
    <div class="shortcut-photo"><PhotoCategoryArt slug={tile.art} label={tile.title}/></div>
    <strong>{tile.title}</strong><span>{tile.description}</span>
  </a>)}
</nav>
<style>
  .home-shortcuts{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:16px;margin:24px 0 40px;}
  .home-shortcut{display:flex;flex-direction:column;min-width:0;overflow:hidden;border:1px solid var(--sage-line);border-radius:18px;background:var(--sage-light);color:var(--green-950);text-decoration:none;}
  .shortcut-photo{height:140px;overflow:hidden;}
  strong{padding:14px 14px 4px;}span{padding:0 14px 16px;color:var(--text-soft);line-height:1.5;}
  .home-shortcut:focus-visible{outline:3px solid var(--orange);outline-offset:4px;}
  @media(max-width:900px){.home-shortcuts{grid-template-columns:repeat(2,minmax(0,1fr));}}
  @media(max-width:360px){.home-shortcuts{grid-template-columns:minmax(0,1fr);}}
</style>
