---
interface Props { title: string; category: string; }
const { title, category } = Astro.props;
const context = `${title} ${category}`.toLowerCase();
const photo = /cattle|livestock|farm|feed/.test(context)
  ? '/images/discovery/livestock.webp'
  : /\bcat\b|cats|feline/.test(context)
    ? '/images/discovery/cat.webp'
    : /\bdog\b|dogs|canine/.test(context)
      ? '/images/discovery/dog.webp'
      : '/images/discovery/essentials.webp';
---
<div class="product-image-placeholder">
  <img src={photo} alt="" loading="lazy" decoding="async">
  <span class="product-placeholder-label">Vetit category image <b>Placeholder · not the seller’s photo</b></span>
</div>
