---
import type { ProductAnimal, ProductCategory } from '../../lib/marketplace/featured-products';

type VariantValue = { seller_sku: string; option_attributes: Record<string, string>; amountMinor?: number | null };
type ExistingProduct = { id: string; business_id: string; title: string; description: string | null; category_id: string; moderation_status: string };
interface Props {
  businesses: Array<{ id: string; display_name: string }>;
  categories: ProductCategory[];
  animals: ProductAnimal[];
  product?: ExistingProduct;
  selectedBusinessId?: string;
  selectedSpeciesIds?: string[];
  baseAmountRupees?: number | null;
  variants?: VariantValue[];
  existingImageCount?: number;
}
const { businesses, categories, animals, product, selectedBusinessId, selectedSpeciesIds = [], baseAmountRupees, variants = [], existingImageCount = 0 } = Astro.props;
const displayVariants: VariantValue[] = variants.length ? variants : [{ seller_sku: '', option_attributes: {}, amountMinor: null }];
const remainingImageSlots = Math.max(0, 5 - existingImageCount);
---
<form class="seller-form" method="post" action="/api/seller/product" data-seller-product-form>
  {product && <input type="hidden" name="listing_id" value={product.id} />}
  <label>Seller profile
    <select name="business_id" required>
      {businesses.map((business) => <option value={business.id} selected={business.id === selectedBusinessId}>{business.display_name}</option>)}
    </select>
  </label>
  <label>Product name / उत्पाद का नाम<input name="title" required minlength="3" maxlength="160" value={product?.title ?? ''} autocomplete="off" /></label>
  <p class="seller-form-hint">Product names can use Indian regional scripts. Interface translations and moderation language coverage are enabled progressively. / उत्पाद के नाम भारतीय क्षेत्रीय लिपियों में लिख सकते हैं।</p>
  <label>Product details<textarea name="description" rows="5" maxlength="5000">{product?.description ?? ''}</textarea></label>
  <label>Vetit product category
    <select name="category_id" data-seller-category required>
      <option value="">Choose a category</option>
      {categories.map((category) => <option value={category.id} data-species={category.species.join(',')} selected={category.id === product?.category_id}>{category.label}</option>)}
    </select>
  </label>
  <fieldset class="seller-species-picker"><legend>Pets &amp; livestock this product is for</legend>
    <div class="seller-species-grid" data-seller-species>
      {animals.map((animal) => <label data-species-choice={animal.id}><input type="checkbox" name="species_ids" value={animal.id} checked={selectedSpeciesIds.includes(animal.id)} /><span>{animal.label}</span></label>)}
    </div>
  </fieldset>
  <p class="seller-form-hint">Vetit controls the category list. Choose only the pets or livestock supported by the selected category.</p>
  <fieldset class="seller-pricing-fields"><legend>India pricing (INR)</legend>
    <label>One price for the product<input name="base_amount_minor" type="number" min="1" max="99999999" step="1" inputmode="numeric" placeholder="e.g. 499" value={baseAmountRupees ?? ''} data-base-price /></label>
    <p class="seller-form-hint">Enter rupees. Vetit stores INR prices in paise. Leave this blank when adding priced variants below.</p>
    <div class="seller-variant-list" data-variant-list>
      {displayVariants.map((variant, index) => <div class="seller-variant-row">
        <label>Seller SKU<input name="variant_sku" maxlength="80" value={variant.seller_sku ?? ''} placeholder={`SKU-${index + 1}`} /></label>
        <label>Option<input name="variant_name" maxlength="60" value={Object.keys(variant.option_attributes ?? {})[0] ?? ''} placeholder="Size" /></label>
        <label>Value<input name="variant_value" maxlength="120" value={Object.values(variant.option_attributes ?? {})[0] ?? ''} placeholder="1 kg" /></label>
        <label>Price (₹)<input name="variant_amount_minor" type="number" min="1" max="99999999" step="1" inputmode="numeric" value={variant.amountMinor ? variant.amountMinor / 100 : ''} /></label>
        <button type="button" class="button button-secondary small-button" data-remove-variant>Remove variant</button>
      </div>)}
    </div>
    <button class="button button-secondary small-button" type="button" data-add-variant>Add another variant</button>
  </fieldset>
  <label>Product photos<input type="file" data-product-images data-max-images={remainingImageSlots} accept="image/jpeg,image/png,image/webp,image/avif" multiple disabled={remainingImageSlots === 0} /></label>
  <ul data-image-previews aria-label="Selected photos — local preview only" class="seller-image-previews"></ul>
  <p class="seller-form-hint">{remainingImageSlots === 0 ? 'This product already has the maximum of 5 photos.' : `Photos are optional. Add up to ${remainingImageSlots} JPEG, PNG, WebP or AVIF files, 5 MB each. They remain private until Vetit publishes the listing.`}</p>
  <p class="seller-feedback" data-image-status role="status" aria-live="polite" hidden></p>
  <button class="button button-primary" type="submit">{product ? 'Save draft changes' : 'Save product draft'}</button>
  <p class="seller-form-hint">Saving creates or updates a draft. It will not appear in the marketplace until Vetit reviews and publishes it.</p>
</form>
<style>
  .seller-image-previews {display:flex;flex-wrap:wrap;gap:12px;list-style:none;padding:0;}
  .seller-image-previews :global(li) {max-width:150px;overflow-wrap:anywhere;}
  .seller-image-previews :global(img) {display:block;object-fit:contain;background:#f2ecfa;border-radius:8px;}
  .seller-image-previews :global(span) {display:block;font-size:.8rem;}
</style>

<script>
  import { createSupabaseBrowserClient } from '../../lib/supabase/browser';
  import { validateSellerImageSelection } from '../../lib/seller/image-selection.js';
  import { isCanonicalSellerImagePath, sellerImageExtension } from '../../lib/seller/validation.js';

  const form = document.querySelector<HTMLFormElement>('[data-seller-product-form]');
  const imageInput = form?.querySelector<HTMLInputElement>('[data-product-images]');
  const maxImages = Number(imageInput?.dataset.maxImages ?? 5);
  const imageStatus = form?.querySelector<HTMLElement>('[data-image-status]');
  const submitButton = form?.querySelector<HTMLButtonElement>('button[type="submit"]');
  const previews = form?.querySelector<HTMLElement>('[data-image-previews]');
  let previewUrls: string[] = [];
  let saving = false, saveUncertain = false;
  let savedListingId: string | null = null;
  const validId = (value: unknown): value is string => typeof value === 'string' && /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i.test(value);
  const clearPreviews = () => { previewUrls.forEach(url => URL.revokeObjectURL(url)); previewUrls = []; previews?.replaceChildren(); };
  imageInput?.addEventListener('change', () => {
    clearPreviews();
    const files = [...(imageInput.files ?? [])];
    const error = validateSellerImageSelection(files,maxImages);
    if (imageStatus) { imageStatus.hidden = !files.length; imageStatus.classList.toggle('is-error',Boolean(error)); imageStatus.textContent = error ?? `${files.length} photo(s) selected locally. Upload starts only when you save the draft. / तस्वीरें केवल ड्राफ्ट सहेजने पर अपलोड होंगी।`; }
    if (error) return;
    files.forEach(file => { const url = URL.createObjectURL(file); previewUrls.push(url); const row = document.createElement('li'); const image = document.createElement('img'); image.src = url; image.alt = file.name; image.width = 120; image.height = 100; const name = document.createElement('span'); name.textContent = file.name; row.append(image,name); previews?.append(row); });
  });
  window.addEventListener('pagehide', clearPreviews, {once:true});

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (saving || saveUncertain) return;
    if (!form.querySelector('input[name="species_ids"]:checked')) {
      if (imageStatus) { imageStatus.hidden = false; imageStatus.classList.add('is-error'); imageStatus.textContent = 'Choose at least one pet or livestock type for this product.'; }
      return;
    }
    const files = [...(imageInput?.files ?? [])];
    if (validateSellerImageSelection(files,maxImages)) {
      if (imageStatus) { imageStatus.hidden = false; imageStatus.classList.add('is-error'); imageStatus.textContent = `Choose up to ${maxImages} JPEG, PNG, WebP or AVIF photos under 5 MB each.`; }
      return;
    }
    saving = true;
    let rejected = false;
    if (submitButton) submitButton.disabled = true;
    if (imageStatus) { imageStatus.hidden = false; imageStatus.classList.remove('is-error'); imageStatus.textContent = 'Saving your product draft…'; }
    try {
      const payload = new FormData(form);
      const response = await fetch(form.action, { method: 'POST', body: payload, credentials:'same-origin', redirect:'error', headers: { Accept: 'application/json' } });
      if (!response.ok) { rejected = response.status >= 400 && response.status < 500; throw new Error('The product draft was not accepted.'); }
      const { listingId } = await response.json();
      if (!validId(listingId)) throw new Error('Draft confirmation unavailable.');
      savedListingId = listingId;
      let listingField = form.querySelector<HTMLInputElement>('input[name="listing_id"]');
      if (!listingField) { listingField = document.createElement('input'); listingField.type = 'hidden'; listingField.name = 'listing_id'; form.append(listingField); }
      listingField.value = listingId;
      let imageFailure = false;
      if (files.length) {
        if (imageStatus) imageStatus.textContent = 'Draft saved. Uploading your photos…';
        const supabase = createSupabaseBrowserClient();
        for (const [index, file] of files.entries()) {
          const reservationResponse = await fetch('/api/seller/image-reservation', {
            method: 'POST', credentials:'same-origin', redirect:'error', headers: { 'content-type': 'application/json', accept: 'application/json' },
            body: JSON.stringify({ listing_id: listingId, content_type: file.type, alt_text: `${String(payload.get('title') ?? 'Product')} photo ${index + 1}` }),
          });
          if (!reservationResponse.ok) { imageFailure = true; continue; }
          const { path } = await reservationResponse.json();
          if (!isCanonicalSellerImagePath(path,String(payload.get('business_id')),listingId) || !path.endsWith('.'+sellerImageExtension(file.type))) throw new Error('Photo reservation confirmation unavailable.');
          const { error: uploadError } = await supabase.storage.from('listing-images').upload(path, file, { contentType: file.type, upsert: false });
          if (uploadError) {
            imageFailure = true;
            // A lost upload response may conceal a successful write. Preserve
            // the reservation/object for explicit owner inspection and recovery.
          }
        }
      }
      window.location.assign(`/seller/products/${listingId}?saved=1${imageFailure ? '&images=unavailable' : ''}`);
    } catch {
      saveUncertain = Boolean(savedListingId) || !rejected;
      if (imageStatus) {
        imageStatus.hidden = false; imageStatus.classList.add('is-error');
        imageStatus.textContent = savedListingId ? 'Draft saved; photo upload is unconfirmed. Open the saved draft before retrying.' : rejected ? 'Draft not accepted. Check the fields and any conflicting product name.' : 'Save confirmation unavailable. Check your drafts before trying again.';
        if (saveUncertain) { const link = document.createElement('a'); link.textContent = savedListingId ? 'Open saved draft' : 'Check your drafts'; link.href = savedListingId ? `/seller/products/${savedListingId}?images=unavailable` : '/seller'; imageStatus.append(' ',link); }
      }
      if (submitButton) submitButton.disabled = saveUncertain;
    }
    finally { saving = false; }
  });

  const category = document.querySelector<HTMLSelectElement>('[data-seller-category]');
  const speciesContainer = document.querySelector<HTMLElement>('[data-seller-species]');
  if (category && speciesContainer) {
    const syncSpecies = () => {
      const allowed = new Set((category.selectedOptions[0]?.dataset.species || '').split(',').filter(Boolean));
      for (const item of speciesContainer.querySelectorAll<HTMLElement>('[data-species-choice]')) {
        const available = allowed.size === 0 || allowed.has(item.dataset.species ?? '');
        item.hidden = !available;
        const input = item.querySelector<HTMLInputElement>('input');
        if (!available && input) input.checked = false;
      }
    };
    category.addEventListener('change', syncSpecies);
    syncSpecies();
  }

  const addVariant = document.querySelector<HTMLButtonElement>('[data-add-variant]');
  const variantList = document.querySelector<HTMLElement>('[data-variant-list]');
  variantList?.addEventListener('click', event=>{
    if(!(event.target instanceof HTMLElement))return;
    const button=event.target.closest('[data-remove-variant]');
    const row=button?.closest('.seller-variant-row');
    if(!(row instanceof HTMLElement))return;
    if(variantList.querySelectorAll('.seller-variant-row').length>1)row.remove();
    else row.querySelectorAll<HTMLInputElement>('input').forEach(input=>{input.value='';});
  });
  addVariant?.addEventListener('click', () => {
    const rows = variantList?.querySelectorAll<HTMLElement>('.seller-variant-row');
    if (!variantList || !rows?.length || rows.length >= 20) return;
    const row = rows[0].cloneNode(true);
    if (!(row instanceof HTMLElement)) return;
    for (const input of row.querySelectorAll<HTMLInputElement>('input')) input.value = '';
    variantList.append(row);
  });
</script>
