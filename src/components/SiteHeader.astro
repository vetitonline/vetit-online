---
import logo from '../../Vetit-online-transparent.png';

interface Props { adminMode?: boolean; sellerMode?: boolean }
const { adminMode = false, sellerMode = false } = Astro.props;
---
<header class="site-header">
  <a class="site-logo-link" href="/" aria-label="Vetit Online home"><img src={logo.src} alt="Vetit Online"></a>
  <nav class="main-nav" aria-label="Main navigation">
    <a href="/products">Marketplace</a><a href="/shop">Pets &amp; Livestock</a><a href="/services">Pet &amp; Vet Services</a><a href="/seller" aria-current={sellerMode ? 'page' : undefined}>Sell on Vetit</a>
    <a href="/orders">Your orders</a>
    {adminMode && <a href="/admin" aria-current="page">Admin panel</a>}
    {!adminMode && <a href="/#how-it-works">How it works</a>}
  </nav>
  <div class="header-actions">
    <a class="cart-link" href="/cart" aria-label="View your cart" title="View your cart"><span class="cart-icon">🛒</span><span class="cart-count">0</span></a>
    {adminMode ? <a class="login-link" href="/">Customer site</a> : <><a class="login-link" data-session-anonymous href="/login">Log in</a><a class="button button-primary small-button" data-session-anonymous href="/login?mode=join">Join free</a></>}
    <button class="login-link" type="button" data-session-logout hidden>Log out</button>
    <span role="status" aria-live="polite" data-session-status></span>
  </div>
</header>
<style>
  .header-actions [hidden] { display: none !important; }
</style>
<script>
  import { createSupabaseBrowserClient } from '../lib/supabase/browser';
  import { createSessionController } from '../lib/auth/session-controller.js';
  const button = document.querySelector<HTMLButtonElement>('[data-session-logout]');
  const status = document.querySelector<HTMLElement>('[data-session-status]');
  if (button && status) {
    try {
      const controller = createSessionController({
        auth: createSupabaseBrowserClient().auth,
        location: window.location,
        render: (signedIn) => {
          button.hidden = !signedIn;
          document.querySelectorAll<HTMLElement>('[data-session-anonymous]').forEach(el => { el.hidden = signedIn; });
        },
      });
      void controller.check();
      const onFocus = () => { void controller.check(); };
      window.addEventListener('focus', onFocus);
      button.addEventListener('click', async () => {
        button.disabled = true;
        status.textContent = '';
        try { await controller.logout(); }
        catch { status.textContent = 'Could not sign out. Please try again.'; }
        finally { button.disabled = false; }
      });
      window.addEventListener('pagehide', () => {
        controller.dispose();
        window.removeEventListener('focus', onFocus);
      }, { once: true });
      window.addEventListener('pageshow', event => { if (event.persisted) window.location.reload(); });
    } catch { status.textContent = 'Account access is unavailable.'; }
  }
</script>
