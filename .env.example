# Local development is restricted to the existing Vetit TEST project.
PUBLIC_SUPABASE_URL=https://apfyfmokcynqiaxqvvxx.supabase.co
# Use the existing TEST publishable key; never a service-role/secret key.
PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Optional. Set only after a public-read listing images bucket is configured.
PUBLIC_SUPABASE_LISTING_IMAGES_BUCKET=
# Bounded email-link acceptance also needs the approved Test web origin's
# /auth/callback in the Auth redirect allowlist. Editing this template does not
# change hosted Auth settings. Configure values locally; never paste keys in chat.

# Razorpay Route remains disabled until onboarding and eligibility are confirmed.
RAZORPAY_ROUTE_ENABLED=false
RAZORPAY_ROUTE_ELIGIBILITY_CONFIRMED=false
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
