# Supabase project settings. Create the hosted project in Mumbai (ap-south-1).
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Optional. Set only after a public-read listing images bucket is configured.
PUBLIC_SUPABASE_LISTING_IMAGES_BUCKET=

# Razorpay Route remains disabled until onboarding and eligibility are confirmed.
RAZORPAY_ROUTE_ENABLED=false
RAZORPAY_ROUTE_ELIGIBILITY_CONFIRMED=false
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
