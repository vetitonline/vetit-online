{
  "name": "vetit-online",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "test:marketplace-ui": "node --test --test-isolation=none tests/marketplace-workspace.test.mjs tests/marketplace-pages.test.mjs",
    "test:acceptance-readiness": "node --test --test-isolation=none tests/test-acceptance-readiness.test.mjs",
    "check:test-config": "node scripts/check-test-readiness.mjs",
    "test:moderation-enforcement": "node --test --test-isolation=none tests/durable-moderation.test.mjs",
    "test:moderation-automatic": "node --test --test-isolation=none tests/automatic-moderation.test.mjs tests/moderation-api.test.mjs tests/moderation-mobile.test.mjs tests/moderation-panel.test.mjs",
    "test:moderation-session": "node --test --test-isolation=none tests/moderation-session-workspace.test.mjs tests/moderation-screening-boundaries.test.mjs tests/seller-submission-boundaries.test.mjs",
    "test:moderation-review": "node --test --test-isolation=none tests/moderation-text-screening.test.mjs tests/moderation-candidate.test.mjs",
    "test:moderation-native": "node --test --test-isolation=none tests/native-moderation-session.test.mjs tests/native-moderation-queue.test.mjs",
    "check:moderation-api": "node scripts/check-moderation-api.mjs",
    "test:secure-native-auth": "node --test --test-isolation=none tests/secure-native-auth.test.mjs",
    "test:moderation-ui-compat": "node --test --test-isolation=none tests/native-component-compatibility.test.mjs",
    "test:seller-india": "node --test --test-isolation=none tests/seller-india-validation.test.mjs",
    "test:draft-locale": "node --test --test-isolation=none tests/seller-draft-recovery.test.mjs tests/indian-locale-fallback.test.mjs",
    "test:native-appointments": "node --test --test-isolation=none tests/native-appointments.test.mjs",
    "test:native-provider-appointments": "node --test --test-isolation=none tests/native-provider-appointments.test.mjs tests/native-appointments.test.mjs",
    "test:seller": "node --test --test-isolation=none tests/seller-validation.test.mjs tests/seller-test-support.test.mjs",
    "test:seller:integration": "node --test --test-isolation=none tests/seller-backend.integration.test.mjs",
    "test:seller:cleanup": "node tests/seller-test-cleanup.mjs"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@astrojs/vercel": "^11.0.11",
    "astro": "^7.3.5",
    "typescript": "6.0.3"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.2"
  }
